@{
    ViewBag.Title = "Portal Academico";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <div class="border border-success border-2 rounded-3 p-4 bg-light shadow-sm">
            <h1 id="title">Con Autenticación</h1>
            <p>
                Configurar la autenticación en una base de datos externa llamada EntityBD (sin usar la base local).
            </p>

            <p>
                Modificar el Login y Registro para gestionar y autenticar por UserName en lugar de Email (incluyendo contraseña).
            </p>
            <p>
                Ajustar el Navbar para mostrar Inicio, About y Contact a invitados, o "Hola (UserName)" y Película solo a usuarios autenticados.
            </p>

        </div>
    </section> <br><br>

    <div class="row">
        <section class="col-md-4" aria-labelledby="gettingStartedTitle">
            <div class="card h-100 border-success border-2 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="h4 text-center text-success border-bottom pb-2 mb-3" id="gettingStartedTitle">Información Personal</h2>
                        <p class="p-4">
                            <strong>Estudiante:</strong> Carlos Sebastian Tonato Coronel<br />
                            <strong>Carrera:</strong> Ingeniería en Tecnologías de la Información<br />
                            <strong>Correo:</strong> cstonato2@espe.edu.ec <br />
                        </p>
                    </div>
                    <div class="mt-3">
                        <a class="btn btn-outline-success" href="https://go.microsoft.com/fwlink/?LinkId=301865">Más Datos &raquo;</a>
                    </div>
                </div>
            </div>
        </section>
        <section class="col-md-4 text-center" aria-labelledby="autorTitle">
            <div class="card h-100 border-success border-2 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="mb-3">
                            <img src="~/Images/foto-perfil.jpg" alt="Foto de perfil" class="img-thumbnail rounded-circle border border-success border-4" style="width: 200px; height: 200px; object-fit: cover; object-position: 50% 25%;" />
                        </div>
                        <h2 id="autorTitle">Sebastian</h2>
                        <p>
                            <strong>Responsable del Desarrollo</strong><br />
                            Diseño, implementación de componentes y optimización de servicios de backend y frontend.
                        </p>
                        <p><a class="btn btn-outline-success" href="#">Portafolio &raquo;</a></p>
                    </div>
                </div>
            </div>
        </section>
        <section class="col-md-4" aria-labelledby="hostingTitle">
            <div class="card h-100 border-success border-2 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="h4 text-center text-success border-bottom pb-2 mb-3" id="hostingTitle">Contexto Institucional</h2>
                        <p class="p-4">
                            <strong>Institución:</strong> Universidad de las Fuerzas Armadas ESPE<br />
                            <strong>Materia:</strong> Desarrollo Web para Integración de Tecnologías<br />
                            <strong>Docente:</strong> Ing. Juan Fernando Galarraga<br />
                            <strong>Periodo:</strong> 2026
                        </p>
                    </div>
                    <div class="mt-3">
                        <p><a class="btn btn-outline-success" href="https://go.microsoft.com/fwlink/?LinkId=301867">Ver Materia &raquo;</a></p>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>