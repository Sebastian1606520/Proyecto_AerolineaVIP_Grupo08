@using Con_Autenticacion.Models
@{
    ViewBag.Title = "Consultas y reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string consulta = ViewBag.Consulta;
    string fDesde = ViewBag.Desde;
    string fHasta = ViewBag.Hasta;
    int? fRutaId = ViewBag.RutaId;
    int? fAeronaveId = ViewBag.AeronaveId;
    string fEstado = ViewBag.Estado;
    DateTime fechaCorte = (DateTime)ViewBag.FechaCorte;

    // Ocupación
    var vuelos = ViewBag.Vuelos as List<Vuelo>;
    var reservados = ViewBag.Reservados as Dictionary<int, int>;
    var ocupadosConf = ViewBag.OcupadosConfirmados as Dictionary<int, int>;

    // Reservas
    var reservas = ViewBag.Reservas as List<Reserva>;
    var resumenReservas = ViewBag.ResumenReservas as List<object[]>;

    // Pagos
    var compras = ViewBag.Compras as List<Compra>;
}

<style>
    .admin-card {
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        background: #ffffff;
    }

    .admin-card-header {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        border-top-left-radius: 0.75rem;
        border-top-right-radius: 0.75rem;
        padding: 0.85rem 1.25rem;
    }

    .estado-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.3rem 0.6rem;
        border-radius: 0.4rem;
        white-space: nowrap;
    }

    .b-verde {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #6ee7b7;
    }

    .b-rojo {
        background-color: #fee2e2;
        color: #881337;
        border: 1px solid #fca5a5;
    }

    .b-ambar {
        background-color: #fef3c7;
        color: #78350f;
        border: 1px solid #fcd34d;
    }

    .b-gris {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .b-morado {
        background-color: #581c87;
        color: #ffffff;
    }

    .b-oscuro {
        background-color: #0f172a;
        color: #ffffff;
    }

    .num-reservado {
        color: #581c87;
        font-weight: 700;
    }

    .num-ocupado {
        color: #881337;
        font-weight: 700;
    }

    .num-disponible {
        color: #065f46;
        font-weight: 700;
    }
</style>

<main class="container py-5">

    <!-- Encabezado corporativo -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom border-light-subtle gap-3">
        <div>
            <span class="badge bg-dark text-warning px-3 py-2 text-uppercase fw-semibold mb-2" style="letter-spacing: 1px; font-size: 0.75rem;">
                Aerolínea VIP &middot; Pantalla 21
            </span>
            <h2 class="h3 fw-bold text-dark mb-1">Consultas y reportes</h2>
            <p class="text-secondary small mb-0">
                Consultas tabulares sobre vuelos, ocupación, reservas y operaciones comerciales simuladas.
            </p>
        </div>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
            &larr; Administración
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-4 small rounded-3 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <span>&#9888;</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Filtros -->
    <div class="admin-card shadow-sm mb-4">
        <form id="formReporte" action="@Url.Action("Reportes", "Admin")" method="get" class="p-4" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label for="consulta" class="form-label small fw-semibold text-secondary mb-1">Consulta <span class="text-danger">*</span></label>
                    <select id="consulta" name="consulta" class="form-select form-select-sm py-2">
                        <option value="ocupacion" @(consulta == "ocupacion" ? "selected" : "")>Ocupación por vuelo</option>
                        <option value="reservas" @(consulta == "reservas" ? "selected" : "")>Reservas por estado</option>
                        <option value="pagos" @(consulta == "pagos" ? "selected" : "")>Compras y pagos simulados</option>
                    </select>
                </div>
                <div class="col-6 col-md-4">
                    <label for="desde" class="form-label small fw-semibold text-secondary mb-1">Fecha desde <span class="text-danger">*</span></label>
                    <input type="date" id="desde" name="desde" class="form-control form-control-sm py-2" value="@fDesde" required />
                </div>
                <div class="col-6 col-md-4">
                    <label for="hasta" class="form-label small fw-semibold text-secondary mb-1">Fecha hasta <span class="text-danger">*</span></label>
                    <input type="date" id="hasta" name="hasta" class="form-control form-control-sm py-2" value="@fHasta" required aria-describedby="errorRango" />
                </div>
                <div class="col-12 col-md-4">
                    <label for="rutaId" class="form-label small fw-semibold text-secondary mb-1">Ruta (opcional)</label>
                    @Html.DropDownList("rutaId", (SelectList)ViewBag.RutasLista, "Todas", new { @class = "form-select form-select-sm py-2", id = "rutaId" })
                </div>
                <div class="col-12 col-md-4">
                    <label for="aeronaveId" class="form-label small fw-semibold text-secondary mb-1">Aeronave (opcional)</label>
                    @Html.DropDownList("aeronaveId", (SelectList)ViewBag.AeronavesLista, "Todas", new { @class = "form-select form-select-sm py-2", id = "aeronaveId" })
                </div>
                <div class="col-12 col-md-4">
                    <label for="estado" class="form-label small fw-semibold text-secondary mb-1">Estado (opcional)</label>
                    <select id="estado" name="estado" class="form-select form-select-sm py-2">
                        <option value="">Todos</option>
                        @* Estados de vuelo *@
                        <option data-consulta="ocupacion" value="PROGRAMADO" @(fEstado == "PROGRAMADO" ? "selected" : "")>Programado</option>
                        <option data-consulta="ocupacion" value="CONFIRMADO" @(fEstado == "CONFIRMADO" ? "selected" : "")>Confirmado</option>
                        <option data-consulta="ocupacion" value="CANCELADO" @(fEstado == "CANCELADO" ? "selected" : "")>Cancelado</option>
                        <option data-consulta="ocupacion" value="COMPLETADO" @(fEstado == "COMPLETADO" ? "selected" : "")>Completado</option>
                        @* Estados de reserva *@
                        <option data-consulta="reservas" value="PENDIENTE" @(fEstado == "PENDIENTE" && consulta == "reservas" ? "selected" : "")>Pendiente</option>
                        <option data-consulta="reservas" value="CONFIRMADA" @(fEstado == "CONFIRMADA" ? "selected" : "")>Confirmada</option>
                        <option data-consulta="reservas" value="CANCELADA" @(fEstado == "CANCELADA" ? "selected" : "")>Cancelada</option>
                        <option data-consulta="reservas" value="EXPIRADA" @(fEstado == "EXPIRADA" ? "selected" : "")>Expirada</option>
                        @* Estados de compra *@
                        <option data-consulta="pagos" value="PAGADA" @(fEstado == "PAGADA" ? "selected" : "")>Pagada</option>
                        <option data-consulta="pagos" value="PENDIENTE" @(fEstado == "PENDIENTE" && consulta == "pagos" ? "selected" : "")>Pendiente de pago</option>
                        <option data-consulta="pagos" value="ANULADA" @(fEstado == "ANULADA" ? "selected" : "")>Anulada</option>
                    </select>
                </div>
            </div>

            <small id="errorRango" class="text-danger mt-2 @(ViewBag.ErrorFiltro == null ? "d-none" : "d-block")" role="alert" style="font-size: 0.8rem;">
                &#9888; @(ViewBag.ErrorFiltro ?? "Revise el rango de fechas: «Hasta» no puede ser anterior a «Desde» y el rango no puede superar 366 días.")
            </small>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" id="btnConsultar" class="btn btn-dark btn-sm px-4 py-2 fw-semibold">Consultar</button>
                <a href="@Url.Action("Reportes", "Admin", new { consulta = consulta, desde = fDesde, hasta = fHasta, rutaId = fRutaId, aeronaveId = fAeronaveId, estado = fEstado })"
                   class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">Actualizar resultados</a>
            </div>
        </form>
    </div>

    <!-- Fecha de corte (11.4.7) -->
    <div class="alert alert-light border small text-secondary mb-4">
        <strong class="text-dark">&#9432;</strong>
        Datos con corte al <strong>@fechaCorte.ToString("dd/MM/yyyy HH:mm")</strong>.
        @if (consulta == "ocupacion")
        {
            <span>Disponibles = Capacidad − (Reservados + Ocupados). Reservados = asientos pendientes de pago; Ocupados = asientos con compra pagada.</span>
        }
        else if (consulta == "reservas")
        {
            <span>Rango aplicado a la fecha de creación de la reserva. Importe = suma de los importes por tramo.</span>
        }
        else
        {
            <span>Rango aplicado a la fecha de compra. «Conciliación» compara el importe de la compra con el pago simulado aprobado.</span>
        }
    </div>

    @* ===================== OCUPACIÓN POR VUELO ===================== *@
    @if (consulta == "ocupacion" && vuelos != null)
    {
        if (!vuelos.Any())
        {
            <div class="admin-card shadow-sm p-5 text-center"><h3 class="h6 fw-bold text-dark mb-0">No hay resultados para los filtros seleccionados.</h3></div>
        }
        else
        {
            int totalCapacidad = 0, totalReservados = 0, totalOcupados = 0;
            <div class="admin-card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="table-light small text-secondary">
                            <tr>
                                <th class="ps-4">Vuelo</th>
                                <th>Fecha</th>
                                <th>Ruta</th>
                                <th>Aeronave</th>
                                <th class="text-center">Capacidad</th>
                                <th class="text-center">Reservados</th>
                                <th class="text-center">Ocupados</th>
                                <th class="text-center">Disponibles</th>
                                <th class="pe-4">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in vuelos)
                            {
                                int capacidad = v.Aeronave != null ? v.Aeronave.ModeloAeronave.CapacidadAsientos : 0;
                                int res = reservados.ContainsKey(v.VueloId) ? reservados[v.VueloId] : 0;
                                int ocu = ocupadosConf.ContainsKey(v.VueloId) ? ocupadosConf[v.VueloId] : 0;
                                int disp = capacidad - res - ocu;
                                totalCapacidad += capacidad;
                                totalReservados += res;
                                totalOcupados += ocu;
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">VIP@(v.VueloId.ToString("D5"))</td>
                                    <td>@v.FechaOperacion.ToString("dd/MM/yyyy") <small class="text-muted">@v.Frecuencia.HoraSalida.ToString(@"hh\:mm")</small></td>
                                    <td>@v.Frecuencia.Ruta.Aeropuerto.CodigoIATA &rarr; @v.Frecuencia.Ruta.Aeropuerto1.CodigoIATA</td>
                                    <td>@(v.Aeronave != null ? v.Aeronave.Matricula : "Sin asignar")</td>
                                    <td class="text-center">@(capacidad > 0 ? capacidad.ToString() : "—")</td>
                                    <td class="text-center num-reservado">@res</td>
                                    <td class="text-center num-ocupado">@ocu</td>
                                    <td class="text-center num-disponible">@(capacidad > 0 ? disp.ToString() : "—")</td>
                                    <td class="pe-4">@v.EstadoVueloCodigo</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td class="ps-4" colspan="4">Totales (@vuelos.Count vuelos)</td>
                                <td class="text-center">@totalCapacidad</td>
                                <td class="text-center num-reservado">@totalReservados</td>
                                <td class="text-center num-ocupado">@totalOcupados</td>
                                <td class="text-center num-disponible">@(totalCapacidad - totalReservados - totalOcupados)</td>
                                <td class="pe-4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    }

    @* ===================== RESERVAS POR ESTADO ===================== *@
    @if (consulta == "reservas" && reservas != null)
    {
        if (!reservas.Any())
        {
            <div class="admin-card shadow-sm p-5 text-center"><h3 class="h6 fw-bold text-dark mb-0">No hay resultados para los filtros seleccionados.</h3></div>
        }
        else
        {
            @* Resumen por estado *@
            <div class="admin-card shadow-sm mb-4">
                <div class="admin-card-header">
                    <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.5px;">Resumen por estado</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="table-light small text-secondary">
                            <tr>
                                <th class="ps-4">Estado</th>
                                <th class="text-center">Reservas</th>
                                <th class="text-center">Pasajeros</th>
                                <th class="text-end pe-4">Importe (USD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in resumenReservas)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@(fila[0])</td>
                                    <td class="text-center">@(fila[1])</td>
                                    <td class="text-center">@(fila[2])</td>
                                    <td class="text-end pe-4">@(((decimal)fila[3]).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* Detalle *@
            <div class="admin-card shadow-sm">
                <div class="admin-card-header">
                    <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.5px;">Detalle (@reservas.Count reservas)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="table-light small text-secondary">
                            <tr>
                                <th class="ps-4">Código</th>
                                <th>Creada</th>
                                <th>Fecha de viaje</th>
                                <th class="text-center">Pasajeros</th>
                                <th>Estado</th>
                                <th>Compra</th>
                                <th class="text-end pe-4">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in reservas)
                            {
                                var primerVuelo = r.ReservaPasajeroVuelo.Select(a => a.Vuelo).OrderBy(v => v.FechaOperacion).FirstOrDefault();
                                var compra = r.Compra.OrderByDescending(c => c.FechaCompra).FirstOrDefault();
                                string claseReserva = r.EstadoReservaCodigo == "PENDIENTE" ? "b-morado"
                                    : (r.EstadoReservaCodigo == "CONFIRMADA" ? "b-verde"
                                    : (r.EstadoReservaCodigo == "EXPIRADA" ? "b-ambar" : "b-gris"));
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        <a href="@Url.Action("Gestionar", "Reservas", new { id = r.ReservaId })" class="text-dark">@r.CodigoReserva</a>
                                    </td>
                                    <td>@r.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(primerVuelo != null ? primerVuelo.FechaOperacion.ToString("dd/MM/yyyy") : "—")</td>
                                    <td class="text-center">@r.ReservaPasajeroVuelo.Select(a => a.PasajeroId).Distinct().Count()</td>
                                    <td><span class="estado-badge @claseReserva">@r.EstadoReservaCodigo</span></td>
                                    <td>@(compra != null ? compra.EstadoCompraCodigo : "Sin compra")</td>
                                    <td class="text-end pe-4">@r.ReservaPasajeroVuelo.Sum(a => a.ImporteTramo).ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    @* ===================== COMPRAS Y PAGOS SIMULADOS ===================== *@
    @if (consulta == "pagos" && compras != null)
    {
        if (!compras.Any())
        {
            <div class="admin-card shadow-sm p-5 text-center"><h3 class="h6 fw-bold text-dark mb-0">No hay resultados para los filtros seleccionados.</h3></div>
        }
        else
        {
            decimal totalCompras = 0, totalAprobado = 0;
            <div class="admin-card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="table-light small text-secondary">
                            <tr>
                                <th class="ps-4">Reserva</th>
                                <th>Fecha de compra</th>
                                <th>Estado compra</th>
                                <th class="text-end">Importe compra</th>
                                <th class="text-end">Pago aprobado</th>
                                <th class="text-center">Rechazos</th>
                                <th>Último pago simulado</th>
                                <th class="pe-4">Conciliación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in compras)
                            {
                                decimal aprobado = c.Pago.Where(p => p.EstadoPagoCodigo == "APROBADO").Sum(p => p.Importe);
                                int rechazos = c.Pago.Count(p => p.EstadoPagoCodigo == "RECHAZADO");
                                var ultimo = c.Pago.OrderByDescending(p => p.FechaPago).FirstOrDefault();
                                totalCompras += c.Importe;
                                totalAprobado += aprobado;

                                // Conciliación: una compra PAGADA debe tener un pago aprobado por el mismo importe;
                                // una ANULADA o PENDIENTE no debe tener pagos aprobados vigentes.
                                bool cuadra = c.EstadoCompraCodigo == "PAGADA" ? aprobado == c.Importe : aprobado == 0;
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@c.Reserva.CodigoReserva</td>
                                    <td>@c.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="estado-badge @(c.EstadoCompraCodigo == "PAGADA" ? "b-verde" : (c.EstadoCompraCodigo == "ANULADA" ? "b-rojo" : "b-ambar"))">@c.EstadoCompraCodigo</span>
                                    </td>
                                    <td class="text-end">@c.Importe.ToString("N2")</td>
                                    <td class="text-end">@aprobado.ToString("N2")</td>
                                    <td class="text-center">@rechazos</td>
                                    <td class="small">
                                        @if (ultimo != null)
                                        {
                                            <span>@ultimo.EstadoPagoCodigo &middot; @ultimo.MarcaTarjetaCodigo **** @ultimo.UltimosCuatroDigitos</span>
                                            <span class="d-block text-muted">@ultimo.CodigoOperacion</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin intentos de pago</span>
                                        }
                                    </td>
                                    <td class="pe-4">
                                        @if (cuadra)
                                        {
                                            <span class="estado-badge b-verde">Cuadra</span>
                                        }
                                        else
                                        {
                                            <span class="estado-badge b-rojo">Revisar</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td class="ps-4" colspan="3">Totales (@compras.Count compras, USD)</td>
                                <td class="text-end">@totalCompras.ToString("N2")</td>
                                <td class="text-end">@totalAprobado.ToString("N2")</td>
                                <td colspan="3" class="pe-4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    }

    <p class="small text-muted mt-3 mb-0">
        La exportación de reportes se habilitará solo si la función se aprueba. Los gráficos y el dashboard quedan excluidos de la primera entrega.
    </p>
</main>

@section scripts {
    <script>
        $(function () {
            // Muestra solo los estados que corresponden a la consulta elegida
            function filtrarEstados() {
                var consulta = $('#consulta').val();
                $('#estado option[data-consulta]').each(function () {
                    var visible = $(this).data('consulta') === consulta;
                    $(this).prop('hidden', !visible).prop('disabled', !visible);
                });
                var seleccion = $('#estado option:selected');
                if (seleccion.length && seleccion.prop('disabled')) {
                    $('#estado').val('');
                }
            }

            filtrarEstados();
            $('#consulta').on('change', filtrarEstados);

            // Validación del rango de fechas (obligatorio, Hasta >= Desde, máximo 366 días)
            function rangoValido() {
                var desde = $('#desde').val();
                var hasta = $('#hasta').val();
                if (!desde || !hasta) return false;
                if (hasta < desde) return false;
                return (new Date(hasta) - new Date(desde)) / 86400000 <= 366;
            }

            $('#formReporte').on('submit', function (e) {
                if (!rangoValido()) {
                    e.preventDefault();
                    $('#errorRango').removeClass('d-none').addClass('d-block');
                    return;
                }
                $('#btnConsultar').attr('disabled', 'disabled').text('Consultando…');
            });
        });
    </script>
}