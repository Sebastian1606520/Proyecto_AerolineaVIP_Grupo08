@model IEnumerable<Con_Autenticacion.Models.Vuelo>
@{
    ViewBag.Title = "Resultados de vuelos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Tarjeta principal con aspecto de pase de abordar ejecutivo */
    .card-vuelo-custom {
        border-radius: 0.85rem;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .card-vuelo-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
            border-color: #cbd5e1;
        }

    /* Estado atenuado para vuelos expirados */
    .card-vuelo-expirado {
        background: #f8fafc !important;
        border-color: #e2e8f0 !important;
        opacity: 0.80;
    }

        .card-vuelo-expirado:hover {
            transform: none !important;
            box-shadow: none !important;
        }

    /* Línea de trayecto con ícono central */
    .flight-divider-line {
        height: 2px;
        background: #cbd5e1;
        position: relative;
        width: 100%;
    }

    .flight-divider-dot {
        width: 8px;
        height: 8px;
        background: #0f172a;
        border-radius: 50%;
    }

    .flight-icon-mid {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: #ffffff;
        padding: 0 8px;
        font-size: 0.85rem;
    }

    .card-vuelo-expirado .flight-icon-mid {
        background: #f8fafc;
        color: #94a3b8 !important;
    }

    .card-vuelo-expirado .flight-divider-dot {
        background: #94a3b8;
    }
</style>

<main class="container py-5">

    <!-- Encabezado corporativo -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom border-light-subtle gap-3">
        <div>
            <span class="badge bg-dark text-warning px-3 py-2 text-uppercase fw-semibold mb-2" style="letter-spacing: 1.2px; font-size: 0.72rem;">
                Aerolínea VIP &middot; Pantalla 6
            </span>
            <h1 class="h3 fw-bold text-dark mb-1">Resultados de vuelos</h1>
            <p class="text-secondary small mb-0">
                <strong>@(ViewBag.CiudadOrigen ?? "Origen")</strong> &rarr; <strong>@(ViewBag.CiudadDestino ?? "Destino")</strong>
                &middot; @(ViewBag.Fecha != null ? ((DateTime)ViewBag.Fecha).ToString("dd/MM/yyyy") : "Fecha no especificada")
                &middot; @(ViewBag.Pasajeros ?? 1) @(Equals(ViewBag.Pasajeros, 1) ? "pasajero" : "pasajeros")
            </p>
        </div>
        <a href="@Url.Action("Buscar", "Vuelos", new {
               origenId = ViewBag.OrigenId,
               destinoId = ViewBag.DestinoId,
               fecha = (ViewBag.Fecha != null ? ((DateTime)ViewBag.Fecha).ToString("yyyy-MM-dd") : null),
               pasajeros = (ViewBag.Pasajeros ?? 1)
           })" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            &larr; Modificar búsqueda
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-4 small rounded-3 border-0 shadow-sm d-flex align-items-center gap-2">
            <span>&#9888;</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border border-light-subtle shadow-sm rounded-3 bg-white p-5 text-center my-4">
            <span class="display-6 text-muted">&#9992;</span>
            <h2 class="h5 fw-bold text-dark mt-3 mb-2">No hay vuelos para los criterios seleccionados</h2>
            <p class="text-secondary small mb-4">
                @(ViewBag.EsItinerarioEscala == true
                    ? "La ruta Quito – Galápagos (con escala en Guayaquil) opera exclusivamente los días domingo."
                    : "La ruta seleccionada no opera en esta fecha o no existen frecuencias programadas autorizadas.")
            </p>
            <div>
                <a href="@Url.Action("Buscar", "Vuelos", new { origenId = ViewBag.OrigenId, destinoId = ViewBag.DestinoId })" class="btn btn-dark fw-semibold px-4 py-2">
                    Modificar búsqueda
                </a>
            </div>
        </div>
    }
    else if (ViewBag.EsItinerarioEscala == true)
    {
        <!-- CASO ITINERARIO CON ESCALA EN GYE -->
        <div class="d-flex flex-column gap-3 mb-4">
            <div class="card card-vuelo-custom shadow-sm p-4 @(Model.First().YaPartio ? "card-vuelo-expirado" : "")">
                <div class="row align-items-center g-3">

                    <!-- Ruta con escala y tiempos -->
                    <div class="col-12 col-lg-5">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge @(Model.First().YaPartio ? "bg-secondary" : "bg-primary") bg-opacity-10 text-@(Model.First().YaPartio ? "secondary" : "primary") border border-@(Model.First().YaPartio ? "secondary" : "primary")-subtle fw-semibold rounded-pill px-3 py-1" style="font-size: 0.72rem;">
                                Itinerario dominical con escala
                            </span>
                            @if (Model.First().YaPartio)
                            {
                                <span class="badge bg-secondary text-white small">Vuelo ya partió</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border small">1 escala en GYE</span>
                            }
                        </div>

                        <div class="row align-items-center text-center g-1 my-2">
                            <div class="col-4 text-start">
                                <div class="h4 fw-bold text-dark mb-0">@Model.First().Frecuencia.HoraSalida.ToString(@"hh\:mm")</div>
                                <div class="text-secondary small fw-semibold">@ViewBag.CiudadOrigen</div>
                            </div>
                            <div class="col-4 position-relative">
                                <div class="d-flex align-items-center">
                                    <div class="flight-divider-dot"></div>
                                    <div class="flight-divider-line mx-1">
                                        <span class="flight-icon-mid @(Model.First().YaPartio ? "text-muted" : "text-primary")">&#9992;</span>
                                    </div>
                                    <div class="flight-divider-dot"></div>
                                </div>
                                <span class="text-muted d-block mt-1 fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">ESCALA GYE</span>
                            </div>
                            <div class="col-4 text-end">
                                <div class="h4 fw-bold text-dark mb-0">@Model.Last().Frecuencia.HoraLlegada.ToString(@"hh\:mm")</div>
                                <div class="text-secondary small fw-semibold">@ViewBag.CiudadDestino</div>
                            </div>
                        </div>

                        <!-- Detalle por tramo -->
                        <div class="bg-light bg-opacity-75 border border-light-subtle rounded-3 p-2 small mt-2">
                            @foreach (var tramo in Model)
                            {
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-1 text-secondary" style="font-size: 0.75rem;">
                                    <span>
                                        <strong>Tramo:</strong> VIP@(tramo.VueloId.ToString("D5")) &middot;
                                        @tramo.Frecuencia.HoraSalida.ToString(@"hh\:mm")&ndash;@tramo.Frecuencia.HoraLlegada.ToString(@"hh\:mm")
                                    </span>
                                    <span class="d-flex align-items-center gap-2">
                                        <span class="badge bg-white text-dark border">@tramo.AsientosDisponibles disp.</span>
                                        @if (!Model.First().YaPartio)
                                        {
                                            <a href="@Url.Action("Disponibilidad", "Vuelos", new { id = tramo.VueloId, pasajeros = (ViewBag.Pasajeros ?? 1) })" class="text-decoration-none fw-semibold">
                                                Consultar
                                            </a>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Disponibilidad de la conexión -->
                    <div class="col-12 col-lg-3 text-lg-center py-2 py-lg-0 border-start-lg border-light-subtle">
                        @if (Model.First().YaPartio)
                        {
                            <span class="badge bg-secondary text-white px-3 py-2 small fw-semibold">
                                Vuelo ya operado
                            </span>
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Venta cerrada por horario</small>
                        }
                        else if (Model.Min(t => t.AsientosDisponibles) <= 0)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 small fw-semibold">
                                Sin asientos disponibles
                            </span>
                        }
                        else
                        {
                            <div class="text-success fw-bold fs-4 mb-0">
                                @Model.Min(t => t.AsientosDisponibles) <span class="text-muted fs-6 fw-normal">/ 7</span>
                            </div>
                            <small class="text-secondary d-block" style="font-size: 0.75rem;">asientos libres en ambos tramos</small>
                        }
                    </div>

                    <!-- Acciones -->
                    <div class="col-12 col-lg-4 text-lg-end d-flex flex-wrap justify-content-lg-end gap-2 align-items-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold"
                                data-bs-toggle="modal" data-bs-target="#modal-itinerario-galapagos">
                            Ver detalles
                        </button>

                        @if (Model.All(t => t.EsVendible((int)(ViewBag.Pasajeros ?? 1))))
                        {
                            <a href="@Url.Action("SeleccionAsiento", "Reservas", new { id = Model.First().VueloId, pasajeros = (ViewBag.Pasajeros ?? 1) })"
                               class="btn btn-dark btn-sm px-3 py-2 fw-semibold shadow-sm">
                                Seleccionar vuelo &rarr;
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm px-3 py-2 fw-semibold" disabled>
                                @(Model.First().YaPartio ? "Vuelo ya partió" : "No disponible")
                            </button>
                        }
                    </div>

                </div>
            </div>
        </div>

        <!-- Modal Itinerario Galápagos -->
        <div class="modal fade" id="modal-itinerario-galapagos" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-dark text-white py-3">
                        <h2 class="modal-title h6 fw-bold mb-0">Itinerario Dominical con Escala</h2>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body p-4 small">
                        <p class="text-secondary mb-3">Conexión integral en el mismo día mediante aeronaves Embraer Phenom 300E:</p>
                        @foreach (var tramo in Model)
                        {
                            <div class="p-3 border rounded-3 mb-2 bg-light bg-opacity-50">
                                <div class="fw-bold text-dark mb-1">
                                    Vuelo VIP@(tramo.VueloId.ToString("D5"))
                                </div>
                                <div class="text-muted">Horario: @tramo.Frecuencia.HoraSalida.ToString(@"hh\:mm") a @tramo.Frecuencia.HoraLlegada.ToString(@"hh\:mm")</div>
                                <div class="text-muted">Aeronave asignada: @(tramo.Aeronave != null ? tramo.Aeronave.Matricula : "Pendiente")</div>
                                <div class="text-dark fw-semibold mt-1">
                                    Disponibles: @tramo.AsientosDisponibles de 7 asientos
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer bg-light py-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- CASO VUELOS DIRECTOS -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary small fw-semibold">Horario:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-dark active btn-filtro" data-filtro="todos">Todos</button>
                    <button type="button" class="btn btn-outline-dark btn-filtro" data-filtro="manana">Mañana</button>
                    <button type="button" class="btn btn-outline-dark btn-filtro" data-filtro="tarde">Tarde</button>
                    <button type="button" class="btn btn-outline-dark btn-filtro" data-filtro="noche">Noche</button>
                </div>
            </div>
            <small class="text-muted">
                Mostrando <strong id="conteoVuelos" class="text-dark">@Model.Count()</strong> vuelos
            </small>
        </div>

        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var vuelo in Model)
            {
                <div class="card card-vuelo-custom shadow-sm p-4 tarjeta-vuelo @(vuelo.YaPartio ? "card-vuelo-expirado" : "")"
                     data-jornada="@vuelo.Jornada">

                    <div class="row align-items-center g-3">

                        <!-- Trayecto y Horas -->
                        <div class="col-12 col-md-5">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-dark text-warning rounded-pill px-2 py-1 small fw-semibold" style="font-size: 0.7rem;">
                                    VIP@(vuelo.VueloId.ToString("D5"))
                                </span>
                                <div>
                                    @if (vuelo.YaPartio)
                                    {
                                        <span class="badge bg-secondary text-white px-2 py-1 small me-1">Ya partió</span>
                                    }
                                    <span class="text-muted small">@vuelo.DescripcionJornada</span>
                                </div>
                            </div>
                            <div class="row align-items-center text-center g-1">
                                <div class="col-4 text-start">
                                    <div class="h4 fw-bold @(vuelo.YaPartio ? "text-secondary" : "text-dark") mb-0">@vuelo.Frecuencia.HoraSalida.ToString(@"hh\:mm")</div>
                                    <div class="text-secondary small fw-semibold">@ViewBag.CiudadOrigen</div>
                                </div>
                                <div class="col-4 position-relative">
                                    <div class="d-flex align-items-center">
                                        <div class="flight-divider-dot"></div>
                                        <div class="flight-divider-line mx-1">
                                            <span class="flight-icon-mid text-muted">&#9992;</span>
                                        </div>
                                        <div class="flight-divider-dot"></div>
                                    </div>
                                    <span class="text-muted d-block mt-1 fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">DIRECTO</span>
                                </div>
                                <div class="col-4 text-end">
                                    <div class="h4 fw-bold @(vuelo.YaPartio ? "text-secondary" : "text-dark") mb-0">@vuelo.Frecuencia.HoraLlegada.ToString(@"hh\:mm")</div>
                                    <div class="text-secondary small fw-semibold">@ViewBag.CiudadDestino</div>
                                </div>
                            </div>
                            <div class="mt-2 text-muted" style="font-size: 0.75rem;">
                                Aeronave: @(vuelo.Aeronave != null ? vuelo.Aeronave.Matricula : "Pendiente") &middot; Phenom 300E
                            </div>
                        </div>

                        <!-- Estado y Disponibilidad -->
                        <div class="col-12 col-md-3 text-md-center py-2 py-md-0 border-start-md border-light-subtle">
                            @if (vuelo.YaPartio)
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 small fw-semibold">
                                    Vuelo despegado
                                </span>
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Venta cerrada</small>
                            }
                            else if (vuelo.EstadoVueloCodigo == "CANCELADO")
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 small fw-semibold">
                                    Vuelo Cancelado
                                </span>
                            }
                            else if (vuelo.AeronaveId == null)
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 small fw-semibold">
                                    Sin aeronave asignada
                                </span>
                            }
                            else if (vuelo.AsientosDisponibles <= 0)
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 small fw-semibold">
                                    Sin asientos disponibles
                                </span>
                            }
                            else
                            {
                                <div class="text-success fw-bold fs-4 mb-0">
                                    @vuelo.AsientosDisponibles
                                    <span class="text-muted fs-6 fw-normal">/ 7</span>
                                </div>
                                <small class="text-secondary d-block" style="font-size: 0.75rem;">asientos disponibles</small>
                            }
                        </div>

                        <!-- Acciones -->
                        <div class="col-12 col-md-4 text-md-end d-flex flex-wrap justify-content-md-end gap-2 align-items-center">
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2"
                                    data-bs-toggle="modal" data-bs-target="#modal-@vuelo.VueloId">
                                Ver detalles
                            </button>

                            @if (!vuelo.YaPartio)
                            {
                                <a href="@Url.Action("Disponibilidad", "Vuelos", new { id = vuelo.VueloId, pasajeros = (ViewBag.Pasajeros ?? 1) })" class="btn btn-outline-dark btn-sm px-3 py-2">
                                    Disponibilidad
                                </a>
                            }

                            @if (vuelo.EsVendible((int)(ViewBag.Pasajeros ?? 1)))
                            {
                                <a href="@Url.Action("SeleccionAsiento", "Reservas", new { id = vuelo.VueloId, pasajeros = (ViewBag.Pasajeros ?? 1) })"
                                   class="btn btn-dark btn-sm px-3 py-2 fw-semibold shadow-sm">
                                    Seleccionar vuelo &rarr;
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm px-3 py-2 fw-semibold" disabled>
                                    @(vuelo.YaPartio ? "Vuelo ya partió" : "No disponible")
                                </button>
                            }
                        </div>

                    </div>
                </div>

                <!-- Modal Detalles Vuelo Directo -->
                <div class="modal fade" id="modal-@vuelo.VueloId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-dark text-white py-3">
                                <h2 class="modal-title h6 fw-bold mb-0">Detalle del vuelo VIP@(vuelo.VueloId.ToString("D5"))</h2>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body p-4 small">
                                <div class="mb-3">
                                    <span class="text-muted d-block">Ruta:</span>
                                    <strong class="text-dark">
                                        @ViewBag.CiudadOrigen &rarr; @ViewBag.CiudadDestino
                                    </strong>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <span class="text-muted d-block">Salida:</span>
                                        <span class="text-dark fw-semibold">@vuelo.Frecuencia.HoraSalida.ToString(@"hh\:mm")</span>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted d-block">Llegada:</span>
                                        <span class="text-dark fw-semibold">@vuelo.Frecuencia.HoraLlegada.ToString(@"hh\:mm")</span>
                                    </div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <span class="text-muted d-block">Aeronave:</span>
                                        <span class="text-dark">Embraer Phenom 300E</span>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted d-block">Matrícula:</span>
                                        <span class="text-dark fw-semibold">@(vuelo.Aeronave != null ? vuelo.Aeronave.Matricula : "Pendiente")</span>
                                    </div>
                                </div>
                                <div class="border-top pt-2">
                                    <span class="text-muted d-block mb-1">Capacidad e Inventario:</span>
                                    <span>Capacidad total: <strong>7 asientos</strong></span> &middot;
                                    <span>Libres: <strong class="@(vuelo.YaPartio ? "text-secondary" : "text-success")">@vuelo.AsientosDisponibles</strong></span>
                                </div>
                                @if (vuelo.YaPartio)
                                {
                                    <div class="alert alert-secondary py-2 px-3 small mt-3 mb-0">
                                        Este vuelo ya completó su horario de salida o se encuentra en trayecto.
                                    </div>
                                }
                            </div>
                            <div class="modal-footer bg-light py-2">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</main>

@section Scripts {
    <script type="application/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var botonesFiltro = document.querySelectorAll('.btn-filtro');
            var tarjetas = document.querySelectorAll('.tarjeta-vuelo');
            var labelConteo = document.getElementById('conteoVuelos');

            for (var i = 0; i < botonesFiltro.length; i++) {
                botonesFiltro[i].addEventListener('click', function (e) {
                    var btnActivo = e.currentTarget;
                    if (!btnActivo) return;

                    for (var b = 0; b < botonesFiltro.length; b++) {
                        botonesFiltro[b].classList.remove('active');
                    }
                    btnActivo.classList.add('active');

                    var filtro = btnActivo.getAttribute('data-filtro');
                    var contador = 0;

                    for (var t = 0; t < tarjetas.length; t++) {
                        var tarjeta = tarjetas[t];
                        var jornada = tarjeta.getAttribute('data-jornada');

                        if (filtro === 'todos' || jornada === filtro) {
                            tarjeta.style.display = '';
                            contador++;
                        } else {
                            tarjeta.style.display = 'none';
                        }
                    }

                    if (labelConteo) {
                        labelConteo.textContent = contador.toString();
                    }
                });
            }
        });
    </script>
}