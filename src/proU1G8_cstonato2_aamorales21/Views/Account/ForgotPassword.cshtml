@model Con_Autenticacion.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar acceso";
}

<main class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6">

            <div class="card border border-light-subtle shadow-sm rounded-3 bg-white p-4">
                <div class="mb-3">
                    <span class="badge bg-dark text-warning px-3 py-2 text-uppercase fw-semibold mb-2" style="letter-spacing: 1px;">
                        Aerolínea VIP &middot; Pantalla 4
                    </span>
                    <h2 class="h4 fw-bold text-dark mb-1">Recuperar acceso</h2>
                    <p class="text-secondary small mb-0">
                        Ingrese el correo electrónico asociado a su cuenta.
                    </p>
                </div>

                @if (ViewBag.Advertencia != null)
                {
                    <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3">
                        @ViewBag.Advertencia
                    </div>
                }

                @if (ViewBag.SolicitudProcesada == true)
                {
                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                        <strong>Información:</strong> @ViewBag.MensajeNeutral
                    </div>

                    <div class="d-grid mt-3">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-dark fw-semibold py-2">
                            Volver al inicio de sesión
                        </a>
                    </div>
                }
                else
                {
                    using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-2 list-unstyled" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, "Correo electrónico *", new { @class = "form-label small fw-semibold text-secondary" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-sm", placeholder = "correo@ejemplo.com" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="d-grid gap-2">
                            <input type="submit" class="btn btn-dark fw-semibold py-2" value="Solicitar recuperación" />
                            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary btn-sm py-2">
                                Volver al inicio de sesión
                            </a>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}