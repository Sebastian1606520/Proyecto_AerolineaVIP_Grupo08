@model Con_Autenticacion.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar acceso";
}

<main class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">

            <div class="card border border-light-subtle shadow-sm rounded-3 bg-white p-4">
                <div class="mb-3 text-center text-md-start">
                    <span class="badge bg-dark text-warning px-3 py-2 text-uppercase fw-semibold mb-2" style="letter-spacing: 1px;">
                        Aerolínea VIP &middot; Pantalla 4
                    </span>
                    <h2 class="h4 fw-bold text-dark mb-1">Recuperar acceso</h2>
                    <p class="text-secondary small mb-0">
                        Ingrese el correo electrónico asociado a su cuenta.
                    </p>
                </div>

                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form", id = "formForgotPassword" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-2 list-unstyled" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, "Correo electrónico *", new { @class = "form-label small fw-semibold text-secondary" })
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control",
                            id = "Email",
                            type = "email",
                            placeholder = "correo@ejemplo.com",
                            autocomplete = "email",
                            autofocus = "autofocus"
                        })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="d-grid gap-2">
                        <input type="submit" class="btn btn-dark fw-semibold py-2" value="Solicitar recuperación" />
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary py-2">
                            Volver al inicio de sesión
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
</main>

@* Modal emergente para entornos académicos / simulados *@
@if (ViewBag.MostrarModal == true)
{
    bool esExito = ViewBag.ModalTipo == "exito";

    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header @(esExito ? "bg-dark text-white" : "bg-danger text-white")">
                    <h5 class="modal-title fs-6 fw-bold">
                        @ViewBag.ModalTitulo
                    </h5>
                    <a href="@Url.Action("ForgotPassword", "Account")" class="btn-close btn-close-white" aria-label="Cerrar"></a>
                </div>

                <div class="modal-body p-4 text-secondary">
                    <p class="mb-3">@ViewBag.ModalMensaje</p>

                    @if (esExito && ViewBag.ResetUrl != null)
                    {
                        <div class="alert alert-light border small text-break mb-0">
                            <strong>Enlace de recuperación generado:</strong><br />
                            <a href="@ViewBag.ResetUrl" class="fw-semibold text-primary">
                                Restablecer mi contraseña ahora &rarr;
                            </a>
                        </div>
                    }
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    @if (esExito && ViewBag.ResetUrl != null)
                    {
                        <a href="@ViewBag.ResetUrl" class="btn btn-warning text-dark fw-semibold px-4">
                            Cambiar contraseña
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ForgotPassword", "Account")" class="btn btn-outline-secondary px-4">
                            Intentar de nuevo
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}