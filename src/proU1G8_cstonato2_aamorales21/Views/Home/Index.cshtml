@{
    ViewBag.Title = "Inicio - Aerolínea VIP";
}

<style>
    /* ==========================================================================
       HERO & BRANDING VIP
       ========================================================================== */
    .hero-banner {
        background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0f172a 100%);
        border-radius: 20px;
        color: #ffffff;
        padding: 48px 24px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.25);
    }

        .hero-banner::after {
            content: "";
            position: absolute;
            top: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.12) 0%, transparent 70%);
            pointer-events: none;
        }

    /* ==========================================================================
       TARJETA DE BÚSQUEDA
       ========================================================================== */
    .search-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
        margin-top: -30px;
        position: relative;
        z-index: 10;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0f172a;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
    }

    /* ==========================================================================
       TARJETAS DE DESTINOS Y OPERACIÓN
       ========================================================================== */
    .route-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        position: relative;
        overflow: hidden;
    }

        .route-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background-color: #0f172a;
            transition: background-color 0.2s ease;
        }

        .route-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 20px -5px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

            .route-card:hover::before {
                background-color: #f59e0b;
            }

    /* ==========================================================================
       FICHA ACADÉMICA / METADATOS DEL PROYECTO
       ========================================================================== */
    .academic-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        transition: border-color 0.2s ease;
    }

        .academic-card:hover {
            border-color: #cbd5e1;
        }

    .badge-vip {
        background-color: #0f172a;
        color: #f59e0b;
        letter-spacing: 1px;
        font-size: 0.72rem;
    }
</style>

<main class="container py-4">

    <!-- ========================================================
         HERO SECTION: IDENTIDAD CORPORATIVA
         ======================================================== -->
    <div class="hero-banner text-center mb-4">
        <div class="d-inline-flex align-items-center gap-2 mb-3">
            <span class="badge badge-vip px-3 py-1 text-uppercase fw-semibold rounded-pill">
                Aerolínea VIP &middot; Servicio Corporativo
            </span>
            <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-50 small rounded-pill">
                Flota Embraer Phenom 300E
            </span>
        </div>
        <h1 class="display-6 fw-bold mb-2">Vuela con exclusividad y confort</h1>
        <p class="text-light opacity-75 lead fs-6 mb-0 mx-auto" style="max-width: 650px;">
            Itinerarios privados con atención personalizada a bordo de nuestra flota ejecutiva de 7 asientos.
        </p>
    </div>

    <!-- ========================================================
         FORMULARIO DE BÚSQUEDA DE VUELOS
         ======================================================== -->
    <div class="card search-card mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <h4 class="h5 fw-bold text-dark mb-0">Encuentra tu vuelo</h4>
                <span class="badge bg-light text-secondary border small">Capacidad máxima: 7 pasajeros</span>
            </div>

            @using (Html.BeginForm("Resultados", "Vuelos", FormMethod.Get, new { id = "formBuscarVuelos" }))
            {
                <div class="row g-3">
                    <!-- Campo Origen -->
                    <div class="col-12 col-md-3">
                        <label for="selectOrigen" class="form-label small fw-semibold text-secondary mb-1">
                            Origen <span class="text-danger">*</span>
                        </label>
                        @Html.DropDownList("origenId", (SelectList)ViewBag.Origenes,
                            new { @class = "form-select py-2", id = "selectOrigen", required = "required" })
                    </div>

                    <!-- Campo Destino -->
                    <div class="col-12 col-md-3">
                        <label for="selectDestino" class="form-label small fw-semibold text-secondary mb-1">
                            Destino <span class="text-danger">*</span>
                        </label>
                        @Html.DropDownList("destinoId", (SelectList)ViewBag.Destinos, "Seleccionar destino",
                            new { @class = "form-select py-2", id = "selectDestino", required = "required" })
                    </div>

                    <!-- Campo Fecha de Salida -->
                    <div class="col-12 col-md-3">
                        <label for="inputFecha" class="form-label small fw-semibold text-secondary mb-1">
                            Fecha de salida <span class="text-danger">*</span>
                        </label>
                        <input type="date" name="fecha" id="inputFecha" class="form-control py-2"
                               value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <!-- Campo Pasajeros -->
                    <div class="col-12 col-md-3">
                        <label for="inputPasajeros" class="form-label small fw-semibold text-secondary mb-1">
                            Pasajeros <span class="text-danger">*</span>
                        </label>
                        <input type="number" name="pasajeros" id="inputPasajeros" class="form-control py-2"
                               value="1" min="1" max="7" required />
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between mt-4 pt-2 gap-3">
                    <button type="submit" class="btn btn-dark px-4 py-2 fw-semibold shadow-sm">
                        Buscar vuelos disponibles &rarr;
                    </button>
                    <small class="text-muted">
                        &#9432; Tarifas y disponibilidad sujetas a confirmación en tiempo real.
                    </small>
                </div>
            }
        </div>
    </div>

    <!-- ========================================================
         DESTINOS Y DÍAS DE OPERACIÓN (RN-04, RN-05, RN-06)
         ======================================================== -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="h6 fw-bold text-dark text-uppercase mb-0" style="letter-spacing: 0.5px;">
            Rutas y Frecuencias Operativas
        </h5>
        <span class="badge bg-light text-muted border">Operación Regular</span>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-12 col-md-4">
            <div class="card h-100 route-card p-3 p-lg-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="fw-bold text-dark mb-0 fs-6">Guayaquil (GYE)</h6>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle small">3 Vuelos / Día</span>
                </div>
                <p class="small text-muted mb-2"><strong>Frecuencia:</strong> Martes, jueves y sábado</p>
                <div class="p-2 bg-light rounded-2 text-secondary small" style="font-size: 0.78rem;">
                    <strong>Horarios:</strong> 09:00 &middot; 14:00 &middot; 19:00
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 route-card p-3 p-lg-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="fw-bold text-dark mb-0 fs-6">Manta (MEC)</h6>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle small">3 Vuelos / Día</span>
                </div>
                <p class="small text-muted mb-2"><strong>Frecuencia:</strong> Lunes, miércoles y viernes</p>
                <div class="p-2 bg-light rounded-2 text-secondary small" style="font-size: 0.78rem;">
                    <strong>Horarios:</strong> 09:00 &middot; 14:00 &middot; 19:00
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 route-card p-3 p-lg-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="fw-bold text-dark mb-0 fs-6">Galápagos (GPS)</h6>
                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning-subtle small">Itinerario Especial</span>
                </div>
                <p class="small text-muted mb-2"><strong>Frecuencia:</strong> Domingos (escala técnica en GYE)</p>
                <div class="p-2 bg-light rounded-2 text-secondary small" style="font-size: 0.78rem;">
                    <strong>Programación:</strong> 4 tramos encadenados desde las 09:00
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================
         INFORMACIÓN INSTITUCIONAL Y TÉCNICA
         ======================================================== -->
    <div class="border-top pt-4 mb-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="badge bg-dark text-white rounded-pill px-3 py-1 text-uppercase" style="font-size: 0.7rem;">
                Proyecto Académico
            </span>
            <span class="text-secondary small fw-semibold">Grupo 08 &middot; Periodo 2026</span>
        </div>

        <div class="card bg-light border border-light-subtle rounded-3 p-3 mb-4 shadow-sm">
            <h6 class="fw-bold text-dark mb-1">Arquitectura y Especificación del Sistema</h6>
            <p class="text-secondary small mb-0">
                Solución monolítica en ASP.NET MVC 4.8.1 con Entity Framework 6, autenticación ASP.NET Identity sobre bases de datos desacopladas (<code>AerolineaVIP</code> y <code>AerolineaVIP_Identity</code>) montadas en SQL Server.
            </p>
        </div>

        <div class="row g-3">
            <!-- Desarrollador 1 -->
            <div class="col-12 col-md-4">
                <div class="academic-card h-100 p-3">
                    <span class="badge bg-secondary bg-opacity-10 text-dark border mb-2 small">Desarrollador 1</span>
                    <strong class="d-block text-dark">Carlos Sebastian Tonato Coronel</strong>
                    <span class="d-block text-muted small">Ing. en Tecnologías de la Información</span>
                    <span class="d-block text-secondary small mt-1">cstonato2@espe.edu.ec</span>
                </div>
            </div>

            <!-- Desarrollador 2 -->
            <div class="col-12 col-md-4">
                <div class="academic-card h-100 p-3">
                    <span class="badge bg-secondary bg-opacity-10 text-dark border mb-2 small">Desarrollador 2</span>
                    <strong class="d-block text-dark">Anthony Alejandro Morales Mendoza</strong>
                    <span class="d-block text-muted small">Ing. en Tecnologías de la Información</span>
                    <span class="d-block text-secondary small mt-1">ESPE</span>
                </div>
            </div>

            <!-- Contexto Institucional -->
            <div class="col-12 col-md-4">
                <div class="academic-card h-100 p-3">
                    <span class="badge bg-secondary bg-opacity-10 text-dark border mb-2 small">Cátedra</span>
                    <strong class="d-block text-dark">Universidad de las Fuerzas Armadas ESPE</strong>
                    <span class="d-block text-muted small">Desarrollo Web &middot; Ing. Juan Fernando Galarraga</span>
                    <span class="d-block text-secondary small mt-1">Primer Parcial</span>
                </div>
            </div>
        </div>
    </div>

</main>

@section Scripts {
    <script type="application/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('formBuscarVuelos');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var selectOrigen = document.getElementById('selectOrigen');
                    var selectDestino = document.getElementById('selectDestino');

                    var origen = selectOrigen ? selectOrigen.value : '';
                    var destino = selectDestino ? selectDestino.value : '';

                    if (origen && destino && origen === destino) {
                        e.preventDefault();
                        alert('El aeropuerto de origen y el de destino deben ser diferentes.');
                    }
                });
            }
        });
    </script>
}