@model Con_Autenticacion.Models.Vuelo
@{
    ViewBag.Title = "Selección de asientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .step-item {
        font-size: 0.78rem;
        letter-spacing: 0.8px;
        color: #94a3b8;
    }
    .step-item.active {
        color: #0f172a;
        font-weight: 700;
        border-bottom: 2px solid #0f172a;
    }

    /* Fuselaje Aerodinámico Responsivo */
    .aircraft-body {
        background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
        border: 2px solid #cbd5e1;
        position: relative;
        box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.06);
        margin: 0 auto;
        width: 100%;
    }

    /* MÓVIL (< 768px): Vertical Compacto */
    @@media (max-width: 767.98px) {
        .aircraft-body {
            max-width: 320px;
            border-radius: 80px 80px 24px 24px;
            padding: 22px 14px 18px 14px;
        }

        .cabin-grid {
            display: grid;
            grid-template-columns: 82px 30px 82px;
            grid-template-rows: auto auto auto auto auto auto;
            gap: 12px 6px;
            justify-content: center;
            align-items: center;
            width: 100%;
        }

        .cockpit-zone {
            grid-column: 1 / span 3;
            grid-row: 1;
            border-bottom: 2px dashed #94a3b8;
            padding-bottom: 10px;
            margin-bottom: 4px;
            text-align: center;
        }

        .cockpit-label {
            letter-spacing: 2px;
            font-size: 0.72rem;
            color: #64748b;
        }

        .seat-1d { grid-column: 3; grid-row: 2; }
        .door-cell { grid-column: 1; grid-row: 2; }
        .seat-2i { grid-column: 1; grid-row: 3; }
        .seat-2d { grid-column: 3; grid-row: 3; }
        .table-i { grid-column: 1; grid-row: 4; }
        .table-d { grid-column: 3; grid-row: 4; }
        .seat-3i { grid-column: 1; grid-row: 5; }
        .seat-3d { grid-column: 3; grid-row: 5; }
        .seat-4i { grid-column: 1; grid-row: 6; }
        .seat-4d { grid-column: 3; grid-row: 6; }

        .aisle-zone {
            grid-column: 2;
            grid-row: 2 / span 5;
            background: linear-gradient(180deg, #e2e8f0 0%, #cbd5e1 100%);
            border-left: 1px dashed #94a3b8;
            border-right: 1px dashed #94a3b8;
            border-radius: 4px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            font-size: 0.65rem;
            letter-spacing: 3px;
            color: #475569;
            font-weight: 700;
        }

        .popa-zone {
            grid-column: 1 / span 3;
            grid-row: 7;
            border-top: 2px dashed #cbd5e1;
            padding-top: 12px;
            margin-top: 4px;
            text-align: center;
        }
    }

    /* ESCRITORIO (>= 768px): Horizontal Proporcional */
    @@media (min-width: 768px) {
        .aircraft-body {
            max-width: 920px;
            border-radius: 100px 24px 24px 100px;
            padding: 26px 34px;
        }

        .cabin-grid {
            display: grid;
            grid-template-columns: 85px repeat(4, 1fr) 110px;
            grid-template-rows: auto auto auto auto;
            gap: 12px 14px;
            align-items: center;
            width: 100%;
        }

        .cockpit-zone {
            grid-column: 1;
            grid-row: 1 / span 4;
            border-right: 2px dashed #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding-right: 14px;
        }

        .cockpit-label {
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            letter-spacing: 2px;
            font-size: 0.72rem;
            color: #64748b;
        }

        .seat-1d { grid-column: 2; grid-row: 1; }
        .seat-2d { grid-column: 3; grid-row: 1; }
        .seat-3d { grid-column: 4; grid-row: 1; }
        .seat-4d { grid-column: 5; grid-row: 1; }
        .table-d { grid-column: 3; grid-row: 2; }
        .table-i { grid-column: 4; grid-row: 2; }

        .aisle-zone {
            grid-column: 2 / span 4;
            grid-row: 3;
            background: linear-gradient(90deg, #e2e8f0 0%, #cbd5e1 50%, #e2e8f0 100%);
            border-top: 1px dashed #94a3b8;
            border-bottom: 1px dashed #94a3b8;
            border-radius: 6px;
            letter-spacing: 4px;
            font-size: 0.68rem;
            color: #475569;
            font-weight: 700;
            text-align: center;
            padding: 5px 0;
            margin: 2px 0;
        }

        .door-cell { grid-column: 2; grid-row: 4; }
        .seat-2i { grid-column: 3; grid-row: 4; }
        .seat-3i { grid-column: 4; grid-row: 4; }
        .seat-4i { grid-column: 5; grid-row: 4; }

        .popa-zone {
            grid-column: 6;
            grid-row: 1 / span 4;
            border-left: 2px dashed #cbd5e1;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-left: 14px;
        }
    }

    /* Butacas Reactivas */
    .seat-checkbox {
        display: none;
    }

    .seat-label {
        width: 100%;
        max-width: 95px;
        height: 70px;
        margin: 0 auto;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        border: 2px solid transparent;
        position: relative;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);
        user-select: none;
    }

    .seat-label.seat-disponible {
        background: linear-gradient(145deg, #047857 0%, #064e3b 100%);
        border-color: #10b981;
        color: #ffffff;
    }

    .seat-label.seat-disponible:hover {
        transform: translateY(-2px) scale(1.02);
    }

    .seat-checkbox:checked + .seat-label {
        background: #0f172a !important;
        border: 3px solid #f59e0b !important;
        color: #ffffff !important;
        transform: translateY(-3px) scale(1.04);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.4) !important;
    }

    .seat-checkbox:checked + .seat-label .check-icon {
        display: block !important;
    }

    .check-icon {
        position: absolute;
        top: 3px;
        right: 6px;
        color: #f59e0b;
        font-size: 0.85rem;
        font-weight: 900;
        display: none;
    }

    .seat-label.seat-reservado {
        background: linear-gradient(145deg, #6b21a8 0%, #3b0764 100%);
        border-color: #a855f7;
        color: #ffffff;
        cursor: not-allowed;
        opacity: 0.85;
    }

    .seat-label.seat-ocupado {
        background: linear-gradient(145deg, #9f1239 0%, #4c0519 100%);
        border-color: #f43f5e;
        color: #ffffff;
        cursor: not-allowed;
        opacity: 0.85;
    }

    .table-zone {
        background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
        border: 1px dashed #94a3b8;
        border-radius: 6px;
        height: 22px;
        width: 100%;
        max-width: 95px;
        margin: 0 auto;
        font-size: 0.65rem;
        color: #475569;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .door-zone {
        background: linear-gradient(145deg, #fffbeb 0%, #fef3c7 100%);
        border: 1.5px dashed #d97706;
        color: #92400e;
        border-radius: 12px;
        width: 100%;
        max-width: 95px;
        height: 70px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 0.62rem;
    }

    /* Estilos del panel de pasajeros a la derecha */
    .passenger-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .passenger-card.assigned {
        border-color: #cbd5e1;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
    }
    .btn-remove-seat {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1px solid #fecdd3;
        background-color: #fff1f2;
        color: #e11d48;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
        padding: 0;
        transition: all 0.15s ease;
    }
    .btn-remove-seat:hover {
        background-color: #ffe4e6;
        border-color: #fda4af;
        color: #be123c;
        transform: scale(1.08);
    }
</style>

<main class="container py-4 py-lg-5">

    <div class="d-flex align-items-center justify-content-center gap-3 gap-md-4 text-uppercase mb-4 pb-2 border-bottom border-light-subtle step-indicator">
        <span class="step-item active pb-2">1. Asientos</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2">2. Pasajeros</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2">3. Confirmar</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2">4. Pago</span>
    </div>

    <!-- Encabezado Corporativo -->
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-dark text-warning px-3 py-1 text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.72rem;">
                            Aerolínea VIP &middot; Pantalla 8
                        </span>
                        <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.75rem;">
                            Flota Embraer Phenom 300E
                        </span>
                    </div>
                    <h1 class="h3 fw-bold text-dark mb-1">Selección de asientos</h1>
                    <p class="text-secondary small mb-0">
                        <strong>@Model.Frecuencia.Ruta.Aeropuerto.Localidad (@Model.Frecuencia.Ruta.Aeropuerto.CodigoIATA)</strong> &rarr;
                        <strong>@ViewBag.UltimoTramo.Frecuencia.Ruta.Aeropuerto1.Localidad (@ViewBag.UltimoTramo.Frecuencia.Ruta.Aeropuerto1.CodigoIATA)</strong>
                        @if ((bool)ViewBag.EsItinerario)
                        {
                            <text>&middot; Itinerario con escala en GYE (@ViewBag.Tramos.Count tramos)</text>
                        }
                        &middot; @ViewBag.Pasajeros pasajero(s)
                    </p>
                </div>
                <a href="@Url.Action("Disponibilidad", "Vuelos", new { id = Model.VueloId, pasajeros = ViewBag.Pasajeros })" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                    &larr; Regresar al mapa
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-4 small rounded-3 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <span>&#9888;</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Formulario Directo -->
    <form action="@Url.Action("SeleccionAsiento", "Reservas")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="vueloId" value="@Model.VueloId" />
        <input type="hidden" name="pasajeros" value="@ViewBag.Pasajeros" />

        <div class="row g-4 align-items-start">

            <!-- Columna Izquierda: Fuselaje -->
            <div class="col-12 col-lg-8">
                @for (int k = 0; k < ViewBag.Tramos.Count; k++)
                {
                    <div class="card border border-light-subtle shadow-sm rounded-4 bg-white p-3 p-md-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="badge bg-dark text-white px-2 py-1 small me-1">Tramo @(k + 1)</span>
                                <strong>@ViewBag.Tramos[k].Frecuencia.Ruta.Aeropuerto.CodigoIATA &rarr; @ViewBag.Tramos[k].Frecuencia.Ruta.Aeropuerto1.CodigoIATA</strong>
                                <small class="text-muted ms-2">(@ViewBag.Tramos[k].Frecuencia.HoraSalida.ToString(@"hh\:mm"))</small>
                            </div>
                            <span class="badge bg-light text-secondary border small">
                                Seleccione @ViewBag.Pasajeros asiento(s)
                            </span>
                        </div>

                        <div class="aircraft-body my-2">
                            <div class="cabin-grid">

                                <div class="cockpit-zone">
                                    <span class="d-block fw-bold text-uppercase cockpit-label">
                                        &#9992; Proa
                                    </span>
                                </div>

                                @foreach (var s in ViewBag.Tramos[k].AsientosCabina)
                                {
                                    <div class="@s.GridClass">
                                        @if (s.EstaDisponible)
                                        {
                                            <input type="@((int)ViewBag.Pasajeros == 1 ? "radio" : "checkbox")"
                                                   id="seat-@(k)-@(s.Numero)"
                                                   name="@(k == 0 ? "asientosSeleccionados" : "asientosTramo2")"
                                                   value="@s.Numero"
                                                   data-codigo="@s.Codigo"
                                                   class="seat-checkbox" />
                                            <label for="seat-@(k)-@(s.Numero)" class="seat-label seat-disponible" title="@s.Ubicacion">
                                                <span class="check-icon">&#10003;</span>
                                                <span class="fs-5">@s.Codigo</span>
                                                <span class="text-uppercase" style="font-size: 0.62rem;">Libre</span>
                                            </label>
                                        }
                                        else
                                        {
                                            <div class="seat-label seat-@s.Estado">
                                                <span class="fs-5">@s.Codigo</span>
                                                <span class="text-uppercase" style="font-size: 0.62rem;">@s.Estado</span>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="table-d"><div class="table-zone">MESA VIP</div></div>
                                <div class="table-i"><div class="table-zone">MESA VIP</div></div>

                                <div class="aisle-zone">
                                    <span class="d-none d-md-inline">&larr; P A S I L L O &nbsp; C E N T R A L &rarr;</span>
                                    <span class="d-inline d-md-none">PASILLO</span>
                                </div>

                                <div class="door-cell">
                                    <div class="door-zone fw-semibold">
                                        <span class="fs-6 mb-1">&#128682;</span>
                                        <span>Acceso</span>
                                    </div>
                                </div>

                                <div class="popa-zone">
                                    <div class="p-2 bg-white border border-light-subtle rounded-3 text-secondary small fw-bold text-center shadow-sm" style="font-size: 0.7rem; width: 100%;">
                                        <span class="fs-6 d-block mb-1 text-dark">&#128701;</span>
                                        Lavatorio VIP<br />
                                        <span class="text-muted fw-normal">&amp; Equipaje</span>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                }
            </div>

            <!-- Columna Derecha: Asignación y Botones de Eliminación -->
            <div class="col-12 col-lg-4">
                <div class="card border border-light-subtle shadow-sm rounded-4 bg-white p-4">

                    <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">
                        Asignación de asientos (@ViewBag.Pasajeros pasajero(s))
                    </h2>

                    <p class="text-secondary small mb-3">
                        Haga clic sobre las butacas verdes en el avión para asignarlas a cada pasajero:
                    </p>

                    <!-- Lista de pasajeros con botón para desmarcar -->
                    <div class="d-flex flex-column gap-2 mb-4">
                        @for (int p = 1; p <= (int)ViewBag.Pasajeros; p++)
                        {
                            <div class="p-3 passenger-card d-flex justify-content-between align-items-center" id="slot-pasajero-@p">
                                <div>
                                    <strong class="text-dark d-block">Pasajero @p</strong>
                                    <small class="text-muted" id="subtitulo-pasajero-@p">Pendiente de selección</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-light text-muted border px-3 py-2 fs-6 fw-bold" id="badge-pasajero-@p">&mdash;</span>
                                    <button type="button"
                                            class="btn-remove-seat d-none"
                                            id="btn-quitar-@p"
                                            data-index="@p"
                                            title="Quitar este asiento"
                                            aria-label="Quitar asiento del pasajero @p">
                                        &times;
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-3 text-secondary">
                        &#9432; Al pulsar continuar, el sistema registrará su selección temporal y avanzará al ingreso de los datos de cada pasajero.
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" id="btnContinuar" class="btn btn-dark py-2 fw-semibold" disabled>
                            Continuar &rarr;
                        </button>
                        <a href="@Url.Action("Disponibilidad", "Vuelos", new { id = Model.VueloId, pasajeros = ViewBag.Pasajeros })" class="btn btn-outline-secondary py-2">
                            Regresar
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </form>

</main>

@section Scripts {
    <script type="application/javascript">
        function actualizarEstadoAsientos() {
            var maxPasajeros = parseInt('@ViewBag.Pasajeros', 10);
            var marcados = document.querySelectorAll('.seat-checkbox:checked');

            // Si se intentan marcar más asientos que pasajeros, se desmarca el último ingresado
            if (marcados.length > maxPasajeros) {
                var exceso = marcados[marcados.length - 1];
                if (exceso) {
                    exceso.click();
                }
                alert('Solo puede seleccionar ' + maxPasajeros + ' asiento(s) para este vuelo.');
                return;
            }

            // Actualizar tarjetas y botones de borrado
            for (var p = 1; p <= maxPasajeros; p++) {
                var slot = document.getElementById('slot-pasajero-' + p);
                var badge = document.getElementById('badge-pasajero-' + p);
                var subtitulo = document.getElementById('subtitulo-pasajero-' + p);
                var btnQuitar = document.getElementById('btn-quitar-' + p);

                if (badge && subtitulo && slot && btnQuitar) {
                    if (p <= marcados.length) {
                        var checkboxActual = marcados[p - 1];
                        var codigo = checkboxActual.getAttribute('data-codigo') || '';

                        badge.textContent = codigo;
                        badge.className = 'badge bg-dark text-warning border px-3 py-2 fs-6 fw-bold shadow-sm';

                        subtitulo.textContent = 'Asiento asignado';
                        subtitulo.className = 'text-success small fw-semibold';

                        slot.classList.add('assigned');

                        // Vincula el ID del checkbox al botón para desmarcarlo directamente al hacer clic
                        btnQuitar.setAttribute('data-target-id', checkboxActual.id);
                        btnQuitar.classList.remove('d-none');
                    } else {
                        badge.innerHTML = '&mdash;';
                        badge.className = 'badge bg-light text-muted border px-3 py-2 fs-6 fw-bold';

                        subtitulo.textContent = 'Pendiente de selección';
                        subtitulo.className = 'text-muted small';

                        slot.classList.remove('assigned');

                        btnQuitar.removeAttribute('data-target-id');
                        btnQuitar.classList.add('d-none');
                    }
                }
            }

            // Habilitar o deshabilitar botón Continuar
            var btn = document.getElementById('btnContinuar');
            if (btn) {
                if (marcados.length === maxPasajeros) {
                    btn.removeAttribute('disabled');
                } else {
                    btn.setAttribute('disabled', 'disabled');
                }
            }
        }

        // Delegación de evento al cambiar estado de checkboxes/radios en el avión
        document.addEventListener('change', function (ev) {
            var target = ev.target;
            if (target && target.classList && target.classList.contains('seat-checkbox')) {
                actualizarEstadoAsientos();
            }
        });

        // Delegación de evento al hacer clic en el botón de eliminar asiento
        document.addEventListener('click', function (ev) {
            var btn = ev.target;
            if (btn && btn.classList && btn.classList.contains('btn-remove-seat')) {
                ev.preventDefault();
                var targetId = btn.getAttribute('data-target-id');
                if (targetId) {
                    var inputCheckbox = document.getElementById(targetId);
                    if (inputCheckbox) {
                        inputCheckbox.click(); // Desmarca el input y actualiza la lista automáticamente
                    }
                }
            }
        });
    </script>
}