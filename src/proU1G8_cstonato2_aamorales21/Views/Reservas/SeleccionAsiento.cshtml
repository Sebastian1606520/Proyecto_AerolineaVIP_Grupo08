@using Con_Autenticacion.Models;
@model Vuelo
@{
    ViewBag.Title = "Selección de asientos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tramos = (List<Vuelo>)ViewBag.Tramos;
    int totalPasajeros = (int)ViewBag.Pasajeros;
    bool esItinerario = tramos.Count > 1;
    var ultimo = tramos.Last();

    // Estado de un asiento en un vuelo: ocupado (rojo), reservado (morado) o disponible (verde)
    Func<Vuelo, int, string> estadoAsiento = (v, n) =>
        v.ReservaPasajeroVuelo.Any(r => r.NumeroAsiento == n && r.EstadoAsignacionCodigo == "CONFIRMADA") ? "ocupado"
        : v.ReservaPasajeroVuelo.Any(r => r.NumeroAsiento == n && r.EstadoAsignacionCodigo == "PENDIENTE") ? "reservado"
        : "disponible";

    Func<Vuelo, int> libres = v =>
        7 - v.ReservaPasajeroVuelo.Count(r => r.EstadoAsignacionCodigo == "PENDIENTE" || r.EstadoAsignacionCodigo == "CONFIRMADA");

    // Distribución del Embraer Phenom 300E (DP-11): número en BD, código y ubicación
    var filaDerecha = new[] {
        new { N = 1, C = "1D", U = "ventanilla derecha, fila 1" },
        new { N = 2, C = "2D", U = "ventanilla derecha, fila 2" },
        new { N = 4, C = "3D", U = "ventanilla derecha, fila 3" },
        new { N = 6, C = "4D", U = "ventanilla derecha, fila 4" }
    };
    var filaIzquierda = new[] {
        new { N = 3, C = "2I", U = "ventanilla izquierda, fila 2" },
        new { N = 5, C = "3I", U = "ventanilla izquierda, fila 3" },
        new { N = 7, C = "4I", U = "ventanilla izquierda, fila 4" }
    };
}

<style>
    .step-indicator {
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .step-item.active {
        color: #0f172a;
        font-weight: 700;
        border-bottom: 2px solid #0f172a;
    }

    .fuselage-container {
        background: #ffffff;
        border: 2px solid #cbd5e1;
        border-radius: 90px 20px 20px 90px;
        padding: 24px 32px;
        position: relative;
    }

    @@media (max-width: 991.98px) {
        .fuselage-container {
            border-radius: 20px;
            padding: 16px;
        }
    }

    .seat-btn {
        width: 78px;
        height: 78px;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        border: 2px solid transparent;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        position: relative;
        cursor: pointer;
    }

    .seat-disponible {
        background-color: #065f46;
        border-color: #044e39;
        color: #ffffff;
    }

        .seat-disponible:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(6, 95, 70, 0.3);
        }

    .seat-reservado {
        background-color: #581c87;
        border-color: #3b0764;
        color: #ffffff;
        cursor: not-allowed;
        opacity: 0.85;
    }

    .seat-ocupado {
        background-color: #881337;
        border-color: #4c0519;
        color: #ffffff;
        cursor: not-allowed;
        opacity: 0.85;
    }

    .seat-seleccionado {
        background-color: #0f172a !important;
        border: 3px solid #f59e0b !important;
        color: #ffffff !important;
        transform: scale(1.06);
        box-shadow: 0 6px 14px rgba(15, 23, 42, 0.4) !important;
    }

    .seat-check-mark {
        position: absolute;
        top: 4px;
        right: 6px;
        color: #f59e0b;
        font-size: 0.85rem;
        font-weight: 900;
    }

    .passenger-slot {
        cursor: pointer;
        transition: all 0.2s ease;
        border-left: 4px solid transparent;
    }

        .passenger-slot.active {
            background-color: #f8fafc;
            border-left-color: #0f172a;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

    .cockpit-zone {
        border-right: 2px dashed #94a3b8;
        padding-right: 18px;
    }

    .aisle-zone {
        background: #f1f5f9;
        border-radius: 6px;
        border-top: 1px dashed #cbd5e1;
        border-bottom: 1px dashed #cbd5e1;
        letter-spacing: 3px;
        font-size: 0.72rem;
        color: #475569;
    }

    .table-zone {
        background: #e2e8f0;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        height: 24px;
        font-size: 0.65rem;
        color: #334155;
    }

    .door-zone {
        background: #fef3c7;
        border: 1.5px dashed #d97706;
        color: #78350f;
        border-radius: 12px;
        font-size: 0.7rem;
    }

    .tab-tramo.active {
        background-color: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
    }
</style>

<main class="container py-5">

    <!-- Indicador de pasos (pantallas 8 a 11) -->
    <div class="d-flex align-items-center justify-content-center gap-4 text-muted small text-uppercase mb-4 pb-2 border-bottom border-light-subtle step-indicator">
        <span class="step-item active pb-2">1. Asientos</span>
        <span class="pb-2">&rarr;</span>
        <span class="pb-2">2. Pasajeros</span>
        <span class="pb-2">&rarr;</span>
        <span class="pb-2">3. Reserva</span>
        <span class="pb-2">&rarr;</span>
        <span class="pb-2">4. Pago</span>
    </div>

    <!-- Encabezado -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom border-light-subtle gap-3">
        <div>
            <span class="badge bg-dark text-warning px-3 py-2 text-uppercase fw-semibold mb-2" style="letter-spacing: 1px; font-size: 0.75rem;">
                Aerolínea VIP &middot; Pantalla 8
            </span>
            <h1 class="h3 fw-bold text-dark mb-1">Seleccione sus asientos</h1>
            <p class="text-secondary small mb-0">
                <strong>@Model.Frecuencia.Ruta.Aeropuerto.Localidad (@Model.Frecuencia.Ruta.Aeropuerto.CodigoIATA)</strong> &rarr;
                <strong>@ultimo.Frecuencia.Ruta.Aeropuerto1.Localidad (@ultimo.Frecuencia.Ruta.Aeropuerto1.CodigoIATA)</strong>
                @if (esItinerario)
                {
                    <text>&middot; itinerario con escala en GYE (@tramos.Count tramos)</text>
                }
                &middot; @totalPasajeros @(totalPasajeros == 1 ? "pasajero" : "pasajeros")
            </p>
        </div>
        <a href="@Url.Action("Disponibilidad", "Vuelos", new { id = Model.VueloId, pasajeros = totalPasajeros })" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
            &larr; Regresar al mapa
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-4 small rounded-3 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <span>&#9888;</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Anuncios para lectores de pantalla -->
    <div id="ariaAnunciador" class="visually-hidden" aria-live="polite"></div>

    <form id="formSeleccionAsientos" action="@Url.Action("SeleccionAsiento", "Reservas")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="vueloId" value="@Model.VueloId" />
        <input type="hidden" name="pasajeros" value="@totalPasajeros" />

        <div class="row g-4 align-items-start">

            <!-- Columna izquierda: pestañas por tramo, datos del vuelo y mapa -->
            <div class="col-12 col-lg-8">

                @if (esItinerario)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3" role="tablist" aria-label="Tramos del itinerario">
                        @for (int k = 0; k < tramos.Count; k++)
                        {
                            var t = tramos[k];
                            <button type="button" class="btn btn-outline-dark btn-sm px-3 py-2 fw-semibold tab-tramo @(k == 0 ? "active" : "")"
                                    data-tramo="@k" role="tab" aria-selected="@(k == 0 ? "true" : "false")">
                                Tramo @(k + 1) &middot; @t.Frecuencia.Ruta.Aeropuerto.CodigoIATA &rarr; @t.Frecuencia.Ruta.Aeropuerto1.CodigoIATA @t.Frecuencia.HoraSalida.ToString(@"hh\:mm")
                            </button>
                        }
                    </div>
                }

                @for (int k = 0; k < tramos.Count; k++)
                {
                    var t = tramos[k];
                    <div class="panel-tramo @(k == 0 ? "" : "d-none")" id="panel-tramo-@k">

                        <!-- Barra de datos del vuelo (wireframe 6.3) -->
                        <div class="card border border-light-subtle shadow-sm rounded-3 bg-white p-3 mb-3">
                            <div class="row g-2 small">
                                <div class="col-6 col-md-4">
                                    <span class="text-muted d-block">Vuelo</span>
                                    <strong class="text-dark">VIP@(t.VueloId.ToString("D5"))</strong>
                                </div>
                                <div class="col-6 col-md-4">
                                    <span class="text-muted d-block">Fecha</span>
                                    <strong class="text-dark">@t.FechaOperacion.ToString("dd/MM/yyyy")</strong>
                                </div>
                                <div class="col-6 col-md-4">
                                    <span class="text-muted d-block">Salida &ndash; llegada</span>
                                    <strong class="text-dark">@t.Frecuencia.HoraSalida.ToString(@"hh\:mm") &ndash; @t.Frecuencia.HoraLlegada.ToString(@"hh\:mm")</strong>
                                </div>
                                <div class="col-6 col-md-4">
                                    <span class="text-muted d-block">Ruta</span>
                                    <strong class="text-dark">@t.Frecuencia.Ruta.Aeropuerto.CodigoIATA &rarr; @t.Frecuencia.Ruta.Aeropuerto1.CodigoIATA</strong>
                                </div>
                                <div class="col-6 col-md-4">
                                    <span class="text-muted d-block">Aeronave</span>
                                    <strong class="text-dark">@(t.Aeronave != null ? t.Aeronave.Matricula : "Pendiente") &middot; Phenom 300E</strong>
                                </div>
                                <div class="col-6 col-md-4">
                                    <span class="text-muted d-block">Capacidad máxima &middot; Disponibles</span>
                                    <strong class="text-dark">7 asientos &middot; <span class="text-success">@libres(t)</span></strong>
                                </div>
                            </div>
                        </div>

                        <!-- Mapa de asientos -->
                        <div class="card border border-light-subtle shadow-sm rounded-4 bg-white p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="small text-muted fw-semibold text-uppercase">
                                    Haga clic en un asiento verde para asignarlo al pasajero activo
                                </span>
                                <span class="badge bg-light text-secondary border small">Embraer Phenom 300E</span>
                            </div>

                            <div class="fuselage-container overflow-auto my-2">
                                <div class="d-flex align-items-center" style="min-width: 760px;">

                                    <div class="cockpit-zone text-center pe-3">
                                        <span class="d-block text-secondary small fw-bold text-uppercase" style="font-size: 0.7rem; writing-mode: vertical-rl; transform: rotate(180deg);">
                                            &#9992; Cabina Mando
                                        </span>
                                    </div>

                                    <div class="flex-grow-1 px-3">

                                        <!-- Lado derecho (D): 1D, 2D, 3D, 4D -->
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small fw-semibold" style="width: 70px;">Lado (D)</span>
                                            @foreach (var s in filaDerecha)
                                            {
                                                var e = estadoAsiento(t, s.N);
                                                <button type="button" class="seat-btn seat-@e"
                                                        data-tramo="@k" data-numero="@s.N" data-codigo="@s.C"
                                                        @(e == "disponible" ? "" : "disabled") aria-pressed="false"
                                                        aria-label="Asiento @s.C, @s.U, @(e == "disponible" ? "libre" : e)">
                                                    <span class="seat-check-mark d-none">&#10003;</span>
                                                    <span class="fs-5 fw-bold">@s.C</span>
                                                    <span class="text-uppercase small" style="font-size: 0.62rem;">@(e == "ocupado" ? "Ocupado" : e == "reservado" ? "Reservado" : "Libre")</span>
                                                </button>
                                            }
                                        </div>

                                        <!-- Mesas entre las filas 2 y 3 -->
                                        <div class="d-flex justify-content-between align-items-center my-1 text-center">
                                            <span style="width: 70px;"></span>
                                            <div style="width: 78px;"></div>
                                            <div class="table-zone d-flex align-items-center justify-content-center fw-semibold" style="width: 78px;">Mesa</div>
                                            <div class="table-zone d-flex align-items-center justify-content-center fw-semibold" style="width: 78px;">Mesa</div>
                                            <div style="width: 78px;"></div>
                                        </div>

                                        <div class="aisle-zone text-center py-1 my-2 fw-semibold">
                                            &larr; P A S I L L O &nbsp; C E N T R A L &rarr;
                                        </div>

                                        <!-- Lado izquierdo (I): puerta, 2I, 3I, 4I -->
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <span class="text-muted small fw-semibold" style="width: 70px;">Lado (I)</span>
                                            <div class="door-zone d-flex flex-column align-items-center justify-content-center fw-semibold" style="width: 78px; height: 78px;">
                                                <span class="fs-6">&#128682;</span>
                                                <span style="font-size: 0.62rem;" class="text-center">Puerta</span>
                                            </div>
                                            @foreach (var s in filaIzquierda)
                                            {
                                                var e = estadoAsiento(t, s.N);
                                                <button type="button" class="seat-btn seat-@e"
                                                        data-tramo="@k" data-numero="@s.N" data-codigo="@s.C"
                                                        @(e == "disponible" ? "" : "disabled") aria-pressed="false"
                                                        aria-label="Asiento @s.C, @s.U, @(e == "disponible" ? "libre" : e)">
                                                    <span class="seat-check-mark d-none">&#10003;</span>
                                                    <span class="fs-5 fw-bold">@s.C</span>
                                                    <span class="text-uppercase small" style="font-size: 0.62rem;">@(e == "ocupado" ? "Ocupado" : e == "reservado" ? "Reservado" : "Libre")</span>
                                                </button>
                                            }
                                        </div>

                                    </div>

                                    <div class="text-center ps-3 border-start border-2 border-secondary-subtle">
                                        <div class="p-2 bg-light rounded-3 text-secondary small fw-bold" style="font-size: 0.68rem;">
                                            &#128701; Baño<br />
                                            <span class="text-muted fw-normal">Privado</span>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- Leyenda (siempre visible) -->
                            <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mt-3 pt-3 border-top border-light-subtle small">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-2" style="width: 16px; height: 16px; background-color: #065f46;"></span>
                                    <span class="text-secondary">Verde · Disponible</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-2" style="width: 16px; height: 16px; background-color: #581c87;"></span>
                                    <span class="text-secondary">Morado · Reservado</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-2" style="width: 16px; height: 16px; background-color: #881337;"></span>
                                    <span class="text-secondary">Rojo · Ocupado</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-2" style="width: 16px; height: 16px; background-color: #0f172a; border: 2px solid #f59e0b;"></span>
                                    <span class="text-secondary fw-semibold">&#10003; Su selección</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Columna derecha: resumen de la selección -->
            <div class="col-12 col-lg-4">
                <div class="card border border-light-subtle shadow-sm rounded-4 bg-white p-4">

                    <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">
                        Resumen de la selección (@totalPasajeros @(totalPasajeros == 1 ? "pasajero" : "pasajeros"))
                    </h2>

                    <div class="d-flex flex-column gap-2 mb-4" id="listaPasajeros">
                        @for (int p = 1; p <= totalPasajeros; p++)
                        {
                            <div class="passenger-slot p-3 border rounded-3 @(p == 1 ? "active" : "")" data-pasajero="@p" id="pasajero-card-@p">
                                <span class="fw-bold text-dark d-block mb-1">Pasajero @p</span>
                                @for (int k = 0; k < tramos.Count; k++)
                                {
                                    <div class="d-flex justify-content-between align-items-center small py-1">
                                        <span class="text-muted">@(esItinerario ? "Tramo " + (k + 1) : "Asiento")</span>
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border fw-bold px-2" id="badge-@k-@p">&mdash;</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-quitar d-none py-0 px-1"
                                                    data-tramo="@k" data-pasajero="@p"
                                                    title="Quitar selección" aria-label="Quitar selección del pasajero @p">
                                                &times;
                                            </button>
                                        </span>
                                    </div>
                                    <input type="hidden" name="@(k == 0 ? "asientosSeleccionados" : "asientosTramo2")" id="input-@k-@p" value="" />
                                }
                            </div>
                        }
                    </div>

                    <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-3 text-secondary">
                        &#9432; Su selección es temporal: la reserva se registra al confirmar en el paso 3.
                        Disponibilidad calculada a las <strong>@ViewBag.HoraCorte</strong>.
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" id="btnContinuar" class="btn btn-dark py-2 fw-semibold" disabled>
                            Continuar &rarr;
                        </button>
                        <a href="@Url.Action("Disponibilidad", "Vuelos", new { id = Model.VueloId, pasajeros = totalPasajeros })" class="btn btn-outline-secondary py-2">
                            Regresar
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </form>

</main>

@section Scripts {
    <script>
        $(function () {
            var pasajeroActivo = 1;
            var tramoActivo = 0;
            var totalPasajeros = @totalPasajeros;
            var totalTramos = @tramos.Count;

            function activarPasajero(p) {
                pasajeroActivo = p;
                $('.passenger-slot').removeClass('active');
                $('#pasajero-card-' + p).addClass('active');
            }

            function desmarcarAsiento(k, numero) {
                var $b = $('.seat-btn[data-tramo="' + k + '"][data-numero="' + numero + '"]');
                $b.removeClass('seat-seleccionado').attr('aria-pressed', 'false');
                $b.find('.seat-check-mark').addClass('d-none');
            }

            function validarCompleto() {
                var completo = true;
                for (var k = 0; k < totalTramos; k++) {
                    for (var p = 1; p <= totalPasajeros; p++) {
                        if (!$('#input-' + k + '-' + p).val()) { completo = false; }
                    }
                }
                $('#btnContinuar').prop('disabled', !completo);
            }

            // Pestañas por tramo
            $('.tab-tramo').on('click', function () {
                tramoActivo = parseInt($(this).data('tramo'));
                $('.tab-tramo').removeClass('active').attr('aria-selected', 'false');
                $(this).addClass('active').attr('aria-selected', 'true');
                $('.panel-tramo').addClass('d-none');
                $('#panel-tramo-' + tramoActivo).removeClass('d-none');
                activarPasajero(1);
            });

            // Elegir el pasajero activo
            $('.passenger-slot').on('click', function () {
                activarPasajero(parseInt($(this).data('pasajero')));
            });

            // Clic en un asiento verde
            $('.seat-btn.seat-disponible').on('click', function () {
                var k = parseInt($(this).data('tramo'));
                var numero = String($(this).data('numero'));
                var codigo = $(this).data('codigo');

                // El mismo asiento no puede ser de dos pasajeros en el mismo tramo
                for (var p = 1; p <= totalPasajeros; p++) {
                    if (p !== pasajeroActivo && $('#input-' + k + '-' + p).val() === numero) {
                        alert('El asiento ' + codigo + ' ya está asignado al Pasajero ' + p + '.');
                        return;
                    }
                }

                var previo = $('#input-' + k + '-' + pasajeroActivo).val();
                if (previo) { desmarcarAsiento(k, previo); }

                $('#input-' + k + '-' + pasajeroActivo).val(numero);
                $('#badge-' + k + '-' + pasajeroActivo).text(codigo);
                $('.btn-quitar[data-tramo="' + k + '"][data-pasajero="' + pasajeroActivo + '"]').removeClass('d-none');
                $(this).addClass('seat-seleccionado').attr('aria-pressed', 'true');
                $(this).find('.seat-check-mark').removeClass('d-none');

                $('#ariaAnunciador').text('Asiento ' + codigo + ' seleccionado para el Pasajero ' + pasajeroActivo);

                // Pasa al siguiente pasajero sin asiento en este tramo
                for (var q = 1; q <= totalPasajeros; q++) {
                    if (!$('#input-' + k + '-' + q).val()) { activarPasajero(q); break; }
                }

                validarCompleto();
            });

            // Quitar selección
            $('.btn-quitar').on('click', function (e) {
                e.stopPropagation();
                var k = $(this).data('tramo');
                var p = parseInt($(this).data('pasajero'));
                var numero = $('#input-' + k + '-' + p).val();
                if (numero) { desmarcarAsiento(k, numero); }
                $('#input-' + k + '-' + p).val('');
                $('#badge-' + k + '-' + p).html('&mdash;');
                $(this).addClass('d-none');
                activarPasajero(p);
                validarCompleto();
            });
        });
    </script>
}