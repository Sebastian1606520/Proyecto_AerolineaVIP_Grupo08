@model Con_Autenticacion.Models.Vuelo
@{
    ViewBag.Title = "Registro de pasajeros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .step-item {
        font-size: 0.78rem;
        letter-spacing: 0.8px;
        color: #94a3b8;
    }
    .step-item.active {
        color: #0f172a;
        font-weight: 700;
        border-bottom: 2px solid #0f172a;
    }

    /* Tarjetas de Pasajeros */
    .passenger-block {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .passenger-block:focus-within {
        border-color: #cbd5e1;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.07);
    }

    .passenger-block-header {
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e2e8f0;
        border-top-left-radius: 14px;
        border-top-right-radius: 14px;
        padding: 1rem 1.25rem;
    }

    .summary-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        position: sticky;
        top: 24px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
    }

    @@media (max-width: 991.98px) {
        .summary-card {
            position: static;
        }
    }

    .form-control:focus, .form-select:focus {
        border-color: #0f172a;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
    }
</style>

<main class="container py-4 py-lg-5">

    <div class="d-flex align-items-center justify-content-center gap-3 gap-md-4 text-uppercase mb-4 pb-2 border-bottom border-light-subtle step-indicator">
        <span class="step-item pb-2 text-secondary">1. Asientos</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item active pb-2">2. Pasajeros</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2 text-secondary">3. Confirmar</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2 text-secondary">4. Pago</span>
    </div>

    <!-- Encabezado Corporativo -->
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-dark text-warning px-3 py-1 text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.72rem;">
                            Aerolínea VIP &middot; Pantalla 9
                        </span>
                        <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.75rem;">
                            Registro Oficial
                        </span>
                    </div>
                    <h1 class="h3 fw-bold text-dark mb-1">Registro de datos del pasajero</h1>
                    <p class="text-secondary small mb-0">
                        Ingrese los datos oficiales de cada viajero conforme a su cédula o pasaporte.
                    </p>
                </div>
                <a href="@Url.Action("SeleccionAsiento", "Reservas", new { id = Model.VueloId, pasajeros = ViewBag.TotalPasajeros })"
                   class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                    &larr; Regresar a asientos
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-4 small rounded-3 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <span>&#9888;</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <form id="formRegistroPasajeros" action="@Url.Action("Pasajeros", "Reservas")" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4 align-items-start">

            <!-- Bloques por pasajero -->
            <div class="col-12 col-lg-8">
                <div class="d-flex flex-column gap-4">

                    @for (int i = 0; i < (int)ViewBag.TotalPasajeros; i++)
                    {
                        <div class="passenger-block">
                            <div class="passenger-block-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge bg-dark text-white rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                                        Pasajero @(i + 1)
                                    </span>
                                    @for (int k = 0; k < ViewBag.CodigosPorPasajero[i].Count; k++)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning-subtle px-2 py-1 small fw-bold">
                                            @((bool)ViewBag.EsItinerario ? "Tramo " + (k + 1) + ":" : "Asiento:") @ViewBag.CodigosPorPasajero[i][k]
                                        </span>
                                    }
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle small fw-semibold">
                                    Butaca reservada
                                </span>
                            </div>

                            <div class="p-4">
                                <!-- Documento -->
                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-5">
                                        <label for="tipo_@i" class="form-label small fw-semibold text-secondary mb-1">
                                            Tipo de documento <span class="text-danger">*</span>
                                        </label>
                                        <select id="tipo_@i" name="pasajeros[@i].TipoDocumentoCodigo" class="form-select form-select-sm py-2 tipo-doc-select" data-index="@i" required>
                                            <option value="CEDULA" @(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count && ViewBag.PasajerosIngresados[i].TipoDocumentoCodigo == "PASAPORTE" ? "" : "selected")>Cédula</option>
                                            <option value="PASAPORTE" @(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count && ViewBag.PasajerosIngresados[i].TipoDocumentoCodigo == "PASAPORTE" ? "selected" : "")>Pasaporte</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-7">
                                        <label for="doc_@i" class="form-label small fw-semibold text-secondary mb-1">
                                            Número de documento <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" name="pasajeros[@i].NumeroDocumento" id="doc_@i"
                                               class="form-control form-control-sm py-2 doc-input"
                                               value="@(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count ? ViewBag.PasajerosIngresados[i].NumeroDocumento : "")"
                                               placeholder="Cédula: 10 dígitos · Pasaporte: 5 a 20 caracteres"
                                               maxlength="20" required aria-describedby="error_doc_@i" />
                                        <small class="text-danger d-none" id="error_doc_@i" role="alert" style="font-size: 0.75rem;"></small>
                                    </div>
                                </div>

                                <!-- Nombres y Apellidos -->
                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-6">
                                        <label for="nom_@i" class="form-label small fw-semibold text-secondary mb-1">
                                            Nombres completos <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="nom_@i" name="pasajeros[@i].Nombres"
                                               class="form-control form-control-sm py-2"
                                               value="@(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count ? ViewBag.PasajerosIngresados[i].Nombres : "")"
                                               placeholder="Ej.: Carlos Sebastián" maxlength="100" required
                                               pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+" title="Solo letras y espacios" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label for="ape_@i" class="form-label small fw-semibold text-secondary mb-1">
                                            Apellidos completos <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="ape_@i" name="pasajeros[@i].Apellidos"
                                               class="form-control form-control-sm py-2"
                                               value="@(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count ? ViewBag.PasajerosIngresados[i].Apellidos : "")"
                                               placeholder="Ej.: Pérez Mendoza" maxlength="100" required
                                               pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+" title="Solo letras y espacios" />
                                    </div>
                                </div>

                                <!-- Contacto Opcional -->
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label for="nac_@i" class="form-label small fw-semibold text-secondary mb-1">
                                            Fecha de nacimiento <span class="text-muted fw-normal">(opcional)</span>
                                        </label>
                                        <input type="date" id="nac_@i" name="pasajeros[@i].FechaNacimiento"
                                               class="form-control form-control-sm py-2"
                                               value="@(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count && ViewBag.PasajerosIngresados[i].FechaNacimiento.HasValue ? ViewBag.PasajerosIngresados[i].FechaNacimiento.Value.ToString("yyyy-MM-dd") : "")"
                                               min="1900-01-02" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="mail_@i" class="form-label small fw-semibold text-secondary mb-1">
                                            Correo electrónico <span class="text-muted fw-normal">(opcional)</span>
                                        </label>
                                        <input type="email" id="mail_@i" name="pasajeros[@i].Correo"
                                               class="form-control form-control-sm py-2"
                                               value="@(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count ? ViewBag.PasajerosIngresados[i].Correo : "")"
                                               placeholder="cliente@ejemplo.com" maxlength="256" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="tel_@i" class="form-label small fw-semibold text-secondary mb-1">
                                            Teléfono móvil <span class="text-muted fw-normal">(opcional)</span>
                                        </label>
                                        <input type="tel" id="tel_@i" name="pasajeros[@i].Telefono"
                                               class="form-control form-control-sm py-2"
                                               value="@(ViewBag.PasajerosIngresados != null && i < ViewBag.PasajerosIngresados.Count ? ViewBag.PasajerosIngresados[i].Telefono : "")"
                                               placeholder="Ej.: 0991234567" maxlength="20"
                                               pattern="[0-9 +]{1,20}" title="Solo números, espacios y +" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>

                <!-- Botones de Acción -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top border-light-subtle gap-2">
                    <a href="@Url.Action("SeleccionAsiento", "Reservas", new { id = Model.VueloId, pasajeros = ViewBag.TotalPasajeros })"
                       class="btn btn-outline-secondary px-3 py-2 fw-semibold small">
                        &larr; Regresar a asientos
                    </a>
                    <button type="submit" id="btnContinuar" class="btn btn-dark px-4 py-2 fw-semibold shadow-sm">
                        Continuar a confirmación &rarr;
                    </button>
                </div>
            </div>

            <!-- Resumen lateral -->
            <div class="col-12 col-lg-4">
                <div class="summary-card p-4">
                    <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">
                        Resumen del Itinerario
                    </h2>

                    <div class="mb-3">
                        <span class="text-muted d-block small">Ruta de vuelo</span>
                        <strong class="text-dark">
                            @Model.Frecuencia.Ruta.Aeropuerto.Localidad (@Model.Frecuencia.Ruta.Aeropuerto.CodigoIATA) &rarr;
                            @ViewBag.UltimoTramo.Frecuencia.Ruta.Aeropuerto1.Localidad (@ViewBag.UltimoTramo.Frecuencia.Ruta.Aeropuerto1.CodigoIATA)
                        </strong>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <span class="text-muted d-block small">Fecha</span>
                            <span class="text-dark fw-semibold">@Model.FechaOperacion.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block small">Aeronave</span>
                            <span class="text-dark fw-semibold">Phenom 300E</span>
                        </div>
                    </div>

                    <ul class="list-unstyled small mb-3 border-top pt-2">
                        @for (int k = 0; k < ViewBag.Tramos.Count; k++)
                        {
                            <li class="mb-2">
                                <span class="badge bg-light text-secondary border me-1">
                                    @((bool)ViewBag.EsItinerario ? "Tramo " + (k + 1) : "Vuelo")
                                </span>
                                <strong>VIP@(((Con_Autenticacion.Models.Vuelo)ViewBag.Tramos[k]).VueloId.ToString("D5"))</strong> &middot;
                                @(((Con_Autenticacion.Models.Vuelo)ViewBag.Tramos[k]).Frecuencia.Ruta.Aeropuerto.CodigoIATA) &rarr;
                                @(((Con_Autenticacion.Models.Vuelo)ViewBag.Tramos[k]).Frecuencia.Ruta.Aeropuerto1.CodigoIATA)
                                <span class="text-muted d-block ms-4">
                                    Salida: @(((Con_Autenticacion.Models.Vuelo)ViewBag.Tramos[k]).Frecuencia.HoraSalida.ToString(@"hh\:mm"))
                                </span>
                            </li>
                        }
                    </ul>

                    <div class="border-top pt-3">
                        <span class="text-muted d-block small mb-2 fw-semibold">Butacas Asignadas:</span>
                        @for (int i = 0; i < (int)ViewBag.TotalPasajeros; i++)
                        {
                            <div class="d-flex justify-content-between align-items-center small mb-2 p-2 bg-light rounded-2">
                                <span class="fw-bold text-secondary">Pasajero @(i + 1)</span>
                                <div>
                                    @for (int k = 0; k < ViewBag.CodigosPorPasajero[i].Count; k++)
                                    {
                                        <span class="badge bg-dark text-warning px-2 py-1">@ViewBag.CodigosPorPasajero[i][k]</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="alert alert-light border small mt-4 mb-0 text-secondary">
                        &#9432; Verifique que los nombres y documentos coincidan exactamente con la identificación oficial.
                    </div>
                </div>
            </div>

        </div>
    </form>

</main>

@section Scripts {
    <script type="application/javascript">
        function validarCedulaEcuatoriana(cedula) {
            if (!cedula || cedula.length !== 10 || !/^\d+$/.test(cedula)) return false;
            var provincia = parseInt(cedula.substring(0, 2), 10);
            if ((provincia < 1 || provincia > 24) && provincia !== 30) return false;
            var tercerDigito = parseInt(cedula.substring(2, 3), 10);
            if (tercerDigito >= 6) return false;

            var suma = 0;
            var coeficientes = [2, 1, 2, 1, 2, 1, 2, 1, 2];
            for (var i = 0; i < 9; i++) {
                var valor = parseInt(cedula.charAt(i), 10) * coeficientes[i];
                suma += (valor >= 10) ? valor - 9 : valor;
            }
            var digitoVerificador = parseInt(cedula.charAt(9), 10);
            var decenaSuperior = Math.ceil(suma / 10) * 10;
            var resultado = decenaSuperior - suma;
            if (resultado === 10) resultado = 0;
            return resultado === digitoVerificador;
        }

        function validarCampoDocumento(indice) {
            var input = document.getElementById('doc_' + indice);
            var tipoSelect = document.getElementById('tipo_' + indice);
            var errorTag = document.getElementById('error_doc_' + indice);

            if (!input || !tipoSelect || !errorTag) return true;

            var tipo = tipoSelect.value;
            var valor = input.value.trim();
            var mensaje = '';

            if (tipo === 'CEDULA') {
                valor = valor.replace(/\D/g, '');
                input.value = valor;
                if (valor.length > 0 && (valor.length !== 10 || !validarCedulaEcuatoriana(valor))) {
                    mensaje = '⚠ Cédula ecuatoriana no válida (debe tener 10 dígitos correctos).';
                }
            } else {
                valor = valor.toUpperCase();
                input.value = valor;
                if (valor.length > 0 && !/^[A-Z0-9]{5,20}$/.test(valor)) {
                    mensaje = '⚠ El pasaporte debe tener entre 5 y 20 caracteres alfanuméricos.';
                }
            }

            if (mensaje) {
                errorTag.textContent = mensaje;
                errorTag.classList.remove('d-none');
                return false;
            } else {
                errorTag.classList.add('d-none');
                return true;
            }
        }

        document.addEventListener('input', function (ev) {
            var elem = ev.target;
            if (elem && elem.classList && elem.classList.contains('doc-input')) {
                validarCampoDocumento(elem.id.replace('doc_', ''));
            }
        });

        document.addEventListener('change', function (ev) {
            var elem = ev.target;
            if (elem && elem.classList && elem.classList.contains('tipo-doc-select')) {
                validarCampoDocumento(elem.getAttribute('data-index'));
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('formRegistroPasajeros');
            if (form) {
                form.addEventListener('submit', function (ev) {
                    var inputs = document.querySelectorAll('.doc-input');
                    var esValido = true;
                    var documentos = [];

                    for (var i = 0; i < inputs.length; i++) {
                        var idx = inputs[i].id.replace('doc_', '');
                        if (!validarCampoDocumento(idx)) {
                            esValido = false;
                        }

                        var tipoDoc = document.getElementById('tipo_' + idx);
                        var clave = (tipoDoc ? tipoDoc.value : '') + '|' + inputs[i].value.trim().toUpperCase();

                        if (inputs[i].value.trim() && documentos.indexOf(clave) !== -1) {
                            alert('No puede registrar el mismo número de documento para dos pasajeros.');
                            esValido = false;
                        }
                        documentos.push(clave);
                    }

                    if (!esValido) {
                        ev.preventDefault();
                    } else {
                        var btn = document.getElementById('btnContinuar');
                        if (btn) {
                            btn.setAttribute('disabled', 'disabled');
                            btn.textContent = 'Guardando…';
                        }
                    }
                });
            }
        });
    </script>
}