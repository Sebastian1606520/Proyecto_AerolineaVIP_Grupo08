<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Aerolínea VIP</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body {
            background-color: #f4f6f8;
        }

        .navbar-brand {
            letter-spacing: 3px;
            font-weight: 700;
        }

        .nav-link:hover {
            color: #ffc107 !important;
        }

        footer a {
            color: #adb5bd;
            text-decoration: none;
        }

            footer a:hover {
                color: #ffc107;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom border-warning border-3">
        <div class="container">
            @Html.ActionLink("AEROLÍNEA VIP", "Index", "Home", new { area = "" }, new { @class = "navbar-brand text-warning" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="menuPrincipal">
                <ul class="navbar-nav">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Vuelos", "Buscar", "Vuelos", new { area = "" }, new { @class = "nav-link" })</li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        @* Se activan cuando existan esas pantallas *@
                        @*<li class="nav-item">@Html.ActionLink("Mis reservas", "MisReservas", "Reservas", new { area = "" }, new { @class = "nav-link" })</li>
            <li class="nav-item">@Html.ActionLink("Check-in", "Index", "CheckIn", new { area = "" }, new { @class = "nav-link" })</li>
            <li class="nav-item">@Html.ActionLink("Comprobantes", "Index", "Comprobantes", new { area = "" }, new { @class = "nav-link" })</li>*@
                    }

                    @if (User.IsInRole("Administrador") || User.IsInRole("SuperUsuario"))
                    {
                        <li class="nav-item">@Html.ActionLink("Vuelos", "Buscar", "Vuelos", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Administración", "Index", "Admin", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Mi Cuenta", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>

                    }
                </ul>

                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>

    <div class="container py-4 flex-grow-1">
        @RenderBody()
    </div>

    <footer class="bg-dark text-secondary py-3 mt-auto border-top border-warning border-3">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center small">
            <span>&copy; @DateTime.Now.Year · Aerolínea VIP · Proyecto académico</span>
            <span>Los pagos son simulados · No se realizan cobros reales</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>