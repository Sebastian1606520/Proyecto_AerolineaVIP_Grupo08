@model Con_Autenticacion.Models.Reserva
@{
    ViewBag.Title = "Confirmación de operación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       INDICADOR DE PASOS VIP
       ========================================================================== */
    .step-item {
        font-size: 0.78rem;
        letter-spacing: 0.8px;
        color: #94a3b8;
    }

        .step-item.active {
            color: #0f172a;
            font-weight: 700;
            border-bottom: 2px solid #0f172a;
        }

    /* ==========================================================================
       BANNERS DE RESULTADO (CARD EXECUTIVE)
       ========================================================================== */
    .outcome-card {
        border-radius: 16px;
        border: 1px solid transparent;
        padding: 1.5rem 1.75rem;
        position: relative;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    }

    .outcome-success {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border-color: #86efac;
        color: #14532d;
    }

    .outcome-danger {
        background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
        border-color: #fca5a5;
        color: #7f1d1d;
    }

    .outcome-warning {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-color: #fde68a;
        color: #78350f;
    }

    .outcome-neutral {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-color: #cbd5e1;
        color: #0f172a;
    }

    .outcome-icon-circle {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    /* ==========================================================================
       BADGES DE ESTADO (ETIQUETAS PÍLDORA)
       ========================================================================== */
    .status-pill {
        padding: 0.4rem 0.9rem;
        font-weight: 700;
        font-size: 0.75rem;
        border-radius: 50rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: 1px solid transparent;
    }

    .status-pill-dark {
        background-color: #0f172a;
        color: #f8fafc;
        border-color: #1e293b;
    }

    .status-pill-success {
        background-color: #ecfdf5;
        color: #065f46;
        border-color: #a7f3d0;
    }

    .status-pill-danger {
        background-color: #fff1f2;
        color: #9f1239;
        border-color: #fecdd3;
    }

    .status-pill-warning {
        background-color: #fffbeb;
        color: #92400e;
        border-color: #fde68a;
    }

    .status-pill-muted {
        background-color: #f1f5f9;
        color: #475569;
        border-color: #cbd5e1;
    }

    /* ==========================================================================
       TABLA Y CONTENEDORES
       ========================================================================== */
    .luxury-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .table-modern thead th {
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #475569;
        text-transform: uppercase;
        font-size: 0.72rem;
        padding: 0.85rem 1rem;
    }

    .table-modern tbody td {
        padding: 0.9rem 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .summary-card-sticky {
        position: sticky;
        top: 24px;
    }

    @@media (max-width: 991.98px) {
        .summary-card-sticky {
            position: static;
        }
    }
</style>

<main class="container py-4 py-lg-5">

    <!-- Indicador de pasos corporativo -->
    <div class="d-flex align-items-center justify-content-center gap-3 gap-md-4 text-uppercase mb-4 pb-2 border-bottom border-light-subtle step-indicator">
        <span class="step-item pb-2 text-secondary">1. Asientos</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2 text-secondary">2. Pasajeros</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2 text-secondary">3. Confirmar</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item active pb-2">4. Pago</span>
    </div>

    <!-- Encabezado -->
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-dark text-warning px-3 py-1 text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.72rem;">
                            Aerolínea VIP &middot; Pantalla 12
                        </span>
                        <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.75rem;">
                            Flota Embraer Phenom 300E
                        </span>
                    </div>
                    <h1 class="h3 fw-bold text-dark mb-1">Resultado de la operación</h1>
                    <p class="text-secondary small mb-0">
                        Comprobante de procesamiento del itinerario y estado de las reservas de cabina.
                    </p>
                </div>
                <div class="p-2 bg-light border border-light-subtle rounded-3 text-secondary small d-flex align-items-center gap-2">
                    <span class="fs-6">&#9432;</span>
                    <span><strong>Simulación académica:</strong> no se aplican débitos reales.</span>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning py-2 px-3 mb-4 small rounded-3 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <span>&#9888;</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Banner principal dinámico -->
    @if ((bool)ViewBag.EsPagada)
    {
        <div class="outcome-card outcome-success mb-4 d-flex gap-3 align-items-center">
            <div class="outcome-icon-circle bg-success text-white shadow-sm">
                &#10003;
            </div>
            <div>
                <h2 class="h5 fw-bold mb-1">Compra y asientos confirmados</h2>
                <p class="small mb-0 opacity-90">
                    La reserva con código <strong>@Model.CodigoReserva</strong> ha sido emitida exitosamente bajo la operación simulada aprobada <strong>@ViewBag.CodigoOperacion</strong>.
                </p>
            </div>
        </div>
    }
    else if ((bool)ViewBag.EsRechazada)
    {
        <div class="outcome-card outcome-danger mb-4 d-flex gap-3 align-items-center">
            <div class="outcome-icon-circle bg-danger text-white shadow-sm">
                &#10007;
            </div>
            <div>
                <h2 class="h5 fw-bold mb-1">Transacción no procesada</h2>
                <p class="small mb-0 opacity-90">
                    El intento de cobro simulado fue rechazado. La reserva <strong>@Model.CodigoReserva</strong> sigue registrada temporalmente y pendiente de pago.
                </p>
            </div>
        </div>
    }
    else if ((bool)ViewBag.EsSoloReserva)
    {
        <div class="outcome-card outcome-warning mb-4 d-flex gap-3 align-items-center">
            <div class="outcome-icon-circle bg-warning text-dark shadow-sm">
                &#9201;
            </div>
            <div>
                <h2 class="h5 fw-bold mb-1">Reserva temporal registrada</h2>
                <p class="small mb-0 opacity-90">
                    Código de reserva <strong>@Model.CodigoReserva</strong> generado con éxito. Los asientos asignados se mantendrán bloqueados
                    @if (Model.FechaExpiracion.HasValue)
                    {
                        <text>hasta el <strong>@Model.FechaExpiracion.Value.ToString("dd/MM/yyyy HH:mm")</strong></text>
                    }
                    para completar el pago.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="outcome-card outcome-neutral mb-4 d-flex gap-3 align-items-center">
            <div class="outcome-icon-circle bg-dark text-white shadow-sm">
                &#9992;
            </div>
            <div>
                <h2 class="h5 fw-bold mb-1">Estado de la reserva: @ViewBag.EstadoReservaTexto</h2>
                <p class="small text-muted mb-0">Información consolidada de la reserva y estado de billetes.</p>
            </div>
        </div>
    }

    <!-- Badges de trazabilidad -->
    <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom border-light-subtle">
        <span class="status-pill status-pill-dark">
            &bull; Reserva: @ViewBag.EstadoReservaTexto
        </span>
        <span class="status-pill @((bool)ViewBag.EsPagada ? "status-pill-success" : "status-pill-warning")">
            &bull; Compra: @ViewBag.EstadoCompraTexto
        </span>
        <span class="status-pill @((bool)ViewBag.EsPagada ? "status-pill-success" : ((bool)ViewBag.EsRechazada ? "status-pill-danger" : "status-pill-muted"))">
            &bull; Pago: @ViewBag.EstadoPagoTexto
        </span>
    </div>

    <div class="row g-4 align-items-start">

        <!-- Detalle de Pasajeros y Butacas -->
        <div class="col-12 col-lg-8">
            <div class="luxury-card overflow-hidden">
                <div class="card-header bg-light border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.5px;">
                        Manifiesto de asignación de butacas
                    </span>
                    <span class="badge bg-white text-secondary border small">
                        @(((List<Con_Autenticacion.Models.ReservaPasajeroVuelo>)ViewBag.Detalle).Count) Asignación(es)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-modern align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Tramo</th>
                                    <th>Vuelo</th>
                                    <th>Ruta</th>
                                    <th>Fecha</th>
                                    <th>Horario</th>
                                    <th>Pasajero</th>
                                    <th class="text-center">Butaca</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in (List<Con_Autenticacion.Models.ReservaPasajeroVuelo>)ViewBag.Detalle)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                T-@(((List<int>)ViewBag.TramosIds).IndexOf(a.VueloId) + 1)
                                            </span>
                                        </td>
                                        <td class="text-nowrap fw-bold text-dark">@a.Vuelo.CodigoVuelo</td>
                                        <td class="text-nowrap">
                                            <strong>@a.Vuelo.CodigoOrigen</strong>
                                            <span class="text-muted">&rarr;</span>
                                            <strong>@a.Vuelo.CodigoDestino</strong>
                                        </td>
                                        <td class="text-nowrap">@a.Vuelo.FechaOperacion.ToString("dd/MM/yyyy")</td>
                                        <td class="text-nowrap text-secondary">
                                            @a.Vuelo.Frecuencia.HoraSalida.ToString(@"hh\:mm") &ndash; @a.Vuelo.Frecuencia.HoraLlegada.ToString(@"hh\:mm")
                                        </td>
                                        <td class="fw-semibold text-dark">
                                            @a.Pasajero.Nombres @a.Pasajero.Apellidos
                                        </td>
                                        <td class="text-center">
                                            <span class="badge text-white px-3 py-1 shadow-sm" style="background-color: @(a.EstadoAsignacionCodigo == "CONFIRMADA" ? "#881337" : (a.EstadoAsignacionCodigo == "PENDIENTE" ? "#581c87" : "#475569")); font-size: 0.85rem;">
                                                @(((Dictionary<int, string>)ViewBag.CodigosAsiento)[a.AsignacionId])
                                            </span>
                                            <small class="d-block text-muted text-uppercase mt-1" style="font-size: 0.65rem;">
                                                @(a.EstadoAsignacionCodigo == "CONFIRMADA" ? "Confirmado" : (a.EstadoAsignacionCodigo == "PENDIENTE" ? "Reservado" : a.EstadoAsignacionCodigo))
                                            </small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resumen Comercial -->
        <div class="col-12 col-lg-4">
            <div class="luxury-card p-4 summary-card-sticky">
                <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3 text-uppercase" style="letter-spacing: 0.5px;">
                    Resumen Financiero
                </h2>

                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Código de Reserva</span>
                    <strong class="text-dark">@Model.CodigoReserva</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Ruta</span>
                    <span class="text-dark text-end fw-semibold">@ViewBag.RutaStr</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Fecha de Vuelo</span>
                    <span class="text-dark">@ViewBag.FechaVuelo</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Horario de Salida</span>
                    <span class="text-dark text-end">@ViewBag.HorarioStr</span>
                </div>
                <div class="d-flex justify-content-between mb-3 small">
                    <span class="text-secondary">Total Pasajeros</span>
                    <span class="text-dark fw-semibold">@ViewBag.NumPasajeros persona(s)</span>
                </div>

                <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-dark d-block">Monto Liquidado</span>
                        <small class="text-muted" style="font-size: 0.72rem;">Tarifa VIP e impuestos incl.</small>
                    </div>
                    <div class="text-end">
                        <span class="fs-4 fw-bold text-dark">$@(((decimal)ViewBag.TotalPagar).ToString("N2"))</span>
                        <small class="text-muted d-block" style="font-size: 0.7rem;">USD</small>
                    </div>
                </div>

                @if ((bool)ViewBag.TienePago)
                {
                    <div class="border-top pt-3 mt-3 p-3 bg-light rounded-3" style="font-size: 0.8rem;">
                        <span class="d-block text-secondary mb-1">
                            Método de pago: <strong class="text-dark">@ViewBag.MetodoPagoTexto</strong>
                        </span>
                        <span class="d-block text-secondary mb-1">
                            Instrumento: <strong class="text-dark">@ViewBag.TarjetaTexto</strong>
                        </span>
                        <span class="d-block text-secondary">
                            ID Transacción: <strong class="text-dark">@ViewBag.CodigoOperacion</strong>
                        </span>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Barra de acciones inferior -->
    <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top justify-content-between align-items-center">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Gestionar", "Reservas", new { id = Model.ReservaId })" class="btn btn-outline-secondary px-3 py-2 fw-semibold small rounded-2">
                &larr; Gestionar esta reserva
            </a>

            @if ((bool)ViewBag.EsPagada && (ViewBag.ComprobanteId as int?).HasValue)
            {
                <a href="@Url.Action("Comprobantes", "Compras", new { ver = ((int?)ViewBag.ComprobanteId).Value })#vistaPrevia" class="btn btn-dark px-4 py-2 fw-semibold small rounded-2 shadow-sm">
                    Consultar comprobante oficial &rarr;
                </a>
            }

            @if ((bool)ViewBag.PuedePagar)
            {
                <a href="@Url.Action("Pagar", "Compras", new { id = Model.ReservaId })" class="btn btn-warning text-dark px-4 py-2 fw-semibold small rounded-2 shadow-sm">
                    @((bool)ViewBag.EsRechazada ? "Reintentar pago" : "Proceder al pago") &rarr;
                </a>
            }
        </div>

        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark px-3 py-2 fw-semibold small rounded-2">
            Volver al inicio
        </a>
    </div>

</main>