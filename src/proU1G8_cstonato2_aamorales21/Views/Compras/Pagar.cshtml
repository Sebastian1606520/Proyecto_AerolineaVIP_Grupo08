@model Con_Autenticacion.Models.Reserva
@{
    ViewBag.Title = "Proceso de compra y pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       INDICADOR DE PASOS VIP
       ========================================================================== */
    .step-item {
        font-size: 0.78rem;
        letter-spacing: 0.8px;
        color: #94a3b8;
    }

        .step-item.active {
            color: #0f172a;
            font-weight: 700;
            border-bottom: 2px solid #0f172a;
        }

    /* ==========================================================================
       SELECTOR DE MARCAS CON CSS PURO (:checked)
       ========================================================================== */
    .brand-radio-input {
        display: none;
    }

    .brand-card-label {
        display: block;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.85rem 0.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #ffffff;
        user-select: none;
    }

        .brand-card-label:hover {
            border-color: #cbd5e1;
            transform: translateY(-2px);
        }

    .brand-radio-input:checked + .brand-card-label {
        border-color: #0f172a !important;
        background-color: #f8fafc !important;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08) !important;
    }

        .brand-radio-input:checked + .brand-card-label .brand-badge {
            background-color: #0f172a !important;
            color: #ffffff !important;
        }

    /* ==========================================================================
       CAMPOS DE TARJETA & CONTENEDORES
       ========================================================================== */
    .card-input-box {
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 1.15rem;
        letter-spacing: 2px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0f172a;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
    }

    .luxury-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .academic-banner {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        border: 1px solid #bfdbfe;
        border-left: 5px solid #2563eb;
    }

    .summary-card-sticky {
        position: sticky;
        top: 24px;
    }

    @@media (max-width: 991.98px) {
        .summary-card-sticky {
            position: static;
        }
    }
</style>

<main class="container py-4 py-lg-5">

    <!-- Indicador de Pasos del Flujo -->
    <div class="d-flex align-items-center justify-content-center gap-3 gap-md-4 text-uppercase mb-4 pb-2 border-bottom border-light-subtle step-indicator">
        <span class="step-item pb-2 text-secondary">1. Asientos</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2 text-secondary">2. Pasajeros</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item pb-2 text-secondary">3. Confirmar</span>
        <span class="step-item pb-2">&rarr;</span>
        <span class="step-item active pb-2">4. Pago</span>
    </div>

    <!-- Encabezado Corporativo -->
    <div class="card border border-light-subtle shadow-sm rounded-3 bg-white mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-dark text-warning px-3 py-1 text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.72rem;">
                            Aerolínea VIP &middot; Pantalla 11
                        </span>
                        <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.75rem;">
                            Flota Embraer Phenom 300E
                        </span>
                    </div>
                    <h1 class="h3 fw-bold text-dark mb-1">Pasarela de pago simulado</h1>
                    <p class="text-secondary small mb-0">
                        Formalice la emisión de boletos para su reserva <strong>@Model.CodigoReserva</strong>.
                    </p>
                </div>
                <a href="@Url.Action("MisReservas", "Reservas")" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                    &larr; Mis reservas
                </a>
            </div>
        </div>
    </div>

    <!-- Aviso de Simulación Académica -->
    <div class="academic-banner p-3 mb-4 rounded-3 d-flex align-items-center gap-3 shadow-sm">
        <span class="fs-3 text-primary">&#9432;</span>
        <div>
            <strong class="text-primary d-block small text-uppercase" style="letter-spacing: 0.5px;">Simulación académica activa</strong>
            <span class="text-secondary small">
                No se conectará a entidades bancarias ni se realizarán cargos reales a su cuenta. Puede utilizar datos ficticios (evite terminación <strong>0000</strong> para no provocar rechazo).
            </span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-4 small rounded-3 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <span>&#9888;</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Formulario Directo Unificado -->
    <form action="@Url.Action("Pagar", "Compras")" method="post" id="formRealPago">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reservaId" value="@Model.ReservaId" />

        <div class="row g-4 align-items-start">

            <!-- Columna Izquierda: Captura de Tarjeta -->
            <div class="col-12 col-lg-8">
                <div class="luxury-card p-4 p-md-5">

                    <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-4 text-uppercase" style="letter-spacing: 0.5px;">
                        Instrumento de Pago
                    </h2>

                    <!-- 1. Método de Pago -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary mb-2">
                            Tipo de cuenta / método <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="metodoPago" id="radioCredito" value="TARJETA_CREDITO" checked>
                                <label class="form-check-label small fw-semibold text-dark" for="radioCredito">Tarjeta de Crédito</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="metodoPago" id="radioDebito" value="TARJETA_DEBITO">
                                <label class="form-check-label small fw-semibold text-dark" for="radioDebito">Tarjeta de Débito</label>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Selección de Marca (Valores en span para evitar advertencias de anidamiento) -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary mb-2">
                            Red de la tarjeta <span class="text-danger">*</span>
                        </label>
                        <div class="row g-2">
                            <div class="col-6 col-sm-3">
                                <input type="radio" name="marcaTarjeta" id="brandVisa" value="VISA" class="brand-radio-input" data-len="16" data-cvv="3" checked />
                                <label for="brandVisa" class="brand-card-label">
                                    <span class="d-block fw-bold text-primary mb-1">VISA</span>
                                    <span class="badge bg-light text-secondary border brand-badge small">16 dígitos</span>
                                </label>
                            </div>
                            <div class="col-6 col-sm-3">
                                <input type="radio" name="marcaTarjeta" id="brandMastercard" value="MASTERCARD" class="brand-radio-input" data-len="16" data-cvv="3" />
                                <label for="brandMastercard" class="brand-card-label">
                                    <span class="d-block fw-bold text-danger mb-1">Mastercard</span>
                                    <span class="badge bg-light text-secondary border brand-badge small">16 dígitos</span>
                                </label>
                            </div>
                            <div class="col-6 col-sm-3">
                                <input type="radio" name="marcaTarjeta" id="brandAmex" value="AMEX" class="brand-radio-input" data-len="15" data-cvv="4" />
                                <label for="brandAmex" class="brand-card-label">
                                    <span class="d-block fw-bold text-info mb-1">Amex</span>
                                    <span class="badge bg-light text-secondary border brand-badge small">15 dígitos</span>
                                </label>
                            </div>
                            <div class="col-6 col-sm-3">
                                <input type="radio" name="marcaTarjeta" id="brandDiners" value="DINERS" class="brand-radio-input" data-len="14" data-cvv="3" />
                                <label for="brandDiners" class="brand-card-label">
                                    <span class="d-block fw-bold text-secondary mb-1">Diners Club</span>
                                    <span class="badge bg-light text-secondary border brand-badge small">14 dígitos</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Campos del Plástico -->
                    <div class="mb-3">
                        <label for="inputNumeroVisual" class="form-label small fw-semibold text-secondary mb-1">
                            Número de tarjeta <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="numeroTarjeta" id="inputNumeroVisual" class="form-control card-input-box py-2" placeholder="0000 0000 0000 0000" maxlength="19" required autocomplete="off" />
                        <small class="text-muted d-block mt-1" style="font-size: 0.75rem;" id="ayudaNumero">Ingrese los 16 dígitos de su tarjeta.</small>
                    </div>

                    <div class="mb-3">
                        <label for="inputTitularVisual" class="form-label small fw-semibold text-secondary mb-1">
                            Titular de la tarjeta <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="titularTarjeta" id="inputTitularVisual" class="form-control py-2 text-uppercase" placeholder="COMO APARECE EN EL PLÁSTICO" maxlength="100" required />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label for="inputVenceVisual" class="form-label small fw-semibold text-secondary mb-1">
                                Vencimiento <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="vencimiento" id="inputVenceVisual" class="form-control py-2 text-center" placeholder="MM/AA" maxlength="5" required />
                            <small class="text-muted" style="font-size: 0.75rem;">Mes / Año (MM/AA)</small>
                        </div>
                        <div class="col-6">
                            <label for="inputCvvVisual" class="form-label small fw-semibold text-secondary mb-1">
                                Código de seguridad <span class="text-danger">*</span>
                            </label>
                            <input type="password" name="codigoSeguridad" id="inputCvvVisual" class="form-control py-2 text-center" placeholder="CVV" maxlength="3" required />
                            <small class="text-muted" style="font-size: 0.75rem;" id="ayudaCvv">3 dígitos al reverso</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light-subtle">
                        <a href="@Url.Action("MisReservas", "Reservas")" class="btn btn-outline-secondary px-3 py-2 fw-semibold small">
                            &larr; Volver
                        </a>
                        <button type="button" id="btnAbrirModal" class="btn btn-dark px-4 py-2 fw-semibold shadow-sm">
                            Pagar $@(((decimal)ViewBag.TotalPagar).ToString("N2")) USD &rarr;
                        </button>
                    </div>

                </div>
            </div>

            <!-- Columna Derecha: Resumen de la Orden -->
            <div class="col-12 col-lg-4">
                <div class="luxury-card p-4 summary-card-sticky">
                    <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3 text-uppercase" style="letter-spacing: 0.5px;">
                        Resumen de la Orden
                    </h2>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Código Reserva</span>
                        <strong class="text-dark">@Model.CodigoReserva</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Ruta</span>
                        <span class="text-dark fw-semibold text-end">@ViewBag.CodigoRuta</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Fecha de Vuelo</span>
                        <span class="text-dark">@ViewBag.FechaVuelo</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Pasajeros</span>
                        <span class="text-dark fw-semibold">@ViewBag.NumPasajeros persona(s)</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Tramos</span>
                        <span class="text-dark">@ViewBag.NumTramos</span>
                    </div>

                    @if (Model.FechaExpiracion.HasValue)
                    {
                        <div class="d-flex justify-content-between mb-3 small">
                            <span class="text-secondary">Pagar antes de</span>
                            <strong class="text-danger">@Model.FechaExpiracion.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    }

                    <div class="border-top pt-3 mt-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-dark d-block">Total a liquidar:</span>
                                <small class="text-muted" style="font-size: 0.72rem;">Tarifa neta + tasas VIP</small>
                            </div>
                            <div class="text-end">
                                <span class="fs-4 fw-bold text-dark">$@(((decimal)ViewBag.TotalPagar).ToString("N2"))</span>
                                <small class="text-muted d-block" style="font-size: 0.7rem;">USD</small>
                            </div>
                        </div>

                        <div class="mt-3 p-2 bg-light rounded-2 border d-flex justify-content-between align-items-center">
                            <span class="small text-secondary">Estado:</span>
                            <span class="badge bg-warning text-dark fw-semibold">Pendiente de pago</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Modal de Confirmación de Transacción -->
        <div class="modal fade" id="modalConfirmarPago" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-3 shadow border-0">
                    <div class="modal-header border-bottom py-3">
                        <h5 class="modal-title fw-bold text-dark fs-6" id="modalLabel">Confirmación de Transacción</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body py-4">
                        <p class="text-secondary small mb-3">
                            ¿Confirma que desea emitir el pago simulado por un total de
                            <strong class="text-dark fs-6">$@(((decimal)ViewBag.TotalPagar).ToString("N2")) USD</strong> para la reserva <strong>@Model.CodigoReserva</strong>?
                        </p>
                        <div class="alert alert-light border small text-muted mb-0">
                            &#9432; Al autorizar, se generará el boleto oficial y se confirmará la asignación final de asientos en cabina.
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light py-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3 fw-semibold" data-bs-dismiss="modal" id="btnCancelarModal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-dark btn-sm px-4 fw-semibold" id="btnEjecutarPago">
                            Confirmar y Pagar
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script type="application/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var digitosEsperados = 16;
            var cvvEsperado = 3;
            var nombreMarca = 'VISA';

            var marcasRadios = document.querySelectorAll('.brand-radio-input');
            var inputNumero = document.getElementById('inputNumeroVisual');
            var inputTitular = document.getElementById('inputTitularVisual');
            var inputVence = document.getElementById('inputVenceVisual');
            var inputCvv = document.getElementById('inputCvvVisual');
            var ayudaNumero = document.getElementById('ayudaNumero');
            var ayudaCvv = document.getElementById('ayudaCvv');
            var btnAbrirModal = document.getElementById('btnAbrirModal');
            var formReal = document.getElementById('formRealPago');
            var btnEjecutarPago = document.getElementById('btnEjecutarPago');
            var btnCancelarModal = document.getElementById('btnCancelarModal');

            for (var i = 0; i < marcasRadios.length; i++) {
                marcasRadios[i].addEventListener('change', function (e) {
                    var target = e.target;
                    if (target && target.checked) {
                        nombreMarca = target.value;
                        digitosEsperados = parseInt(target.getAttribute('data-len') || '16', 10);
                        cvvEsperado = parseInt(target.getAttribute('data-cvv') || '3', 10);

                        if (inputCvv) {
                            inputCvv.setAttribute('maxlength', cvvEsperado.toString());
                        }
                        if (ayudaCvv) {
                            ayudaCvv.textContent = cvvEsperado + ' dígitos al reverso';
                        }
                        if (ayudaNumero) {
                            ayudaNumero.textContent = 'Ingrese los ' + digitosEsperados + ' dígitos para ' + nombreMarca + '.';
                        }
                        if (inputNumero) {
                            inputNumero.value = '';
                        }
                    }
                });
            }

            if (inputNumero) {
                inputNumero.addEventListener('input', function () {
                    var valor = inputNumero.value.replace(/\D/g, '');
                    if (valor.length > digitosEsperados) {
                        valor = valor.substring(0, digitosEsperados);
                    }
                    var partes = [];
                    for (var j = 0; j < valor.length; j += 4) {
                        partes.push(valor.substring(j, j + 4));
                    }
                    inputNumero.value = partes.join(' ');
                });
            }

            if (inputVence) {
                inputVence.addEventListener('input', function () {
                    var v = inputVence.value.replace(/\D/g, '');
                    if (v.length > 4) v = v.substring(0, 4);

                    if (v.length >= 2) {
                        var mes = parseInt(v.substring(0, 2), 10);
                        if (mes > 12) v = '12' + v.substring(2);
                        if (mes === 0) v = '01' + v.substring(2);
                        inputVence.value = v.substring(0, 2) + '/' + v.substring(2);
                    } else {
                        inputVence.value = v;
                    }
                });
            }

            if (inputCvv) {
                inputCvv.addEventListener('input', function () {
                    inputCvv.value = inputCvv.value.replace(/\D/g, '');
                });
            }

            if (btnAbrirModal) {
                btnAbrirModal.addEventListener('click', function () {
                    var num = inputNumero ? inputNumero.value.replace(/\D/g, '') : '';
                    var titular = inputTitular ? inputTitular.value.trim() : '';
                    var vence = inputVence ? inputVence.value.trim() : '';
                    var cvv = inputCvv ? inputCvv.value.trim() : '';

                    if (num.length !== digitosEsperados) {
                        alert('El número de tarjeta debe tener exactamente ' + digitosEsperados + ' dígitos para ' + nombreMarca + '.');
                        if (inputNumero) inputNumero.focus();
                        return;
                    }

                    if (titular.length < 3) {
                        alert('Por favor ingrese el nombre del titular como figura en el plástico.');
                        if (inputTitular) inputTitular.focus();
                        return;
                    }

                    if (vence.length !== 5) {
                        alert('Ingrese una fecha de vencimiento válida en formato MM/AA.');
                        if (inputVence) inputVence.focus();
                        return;
                    }

                    var mesExp = parseInt(vence.substring(0, 2), 10);
                    var anioExp = 2000 + parseInt(vence.substring(3, 5), 10);
                    var hoy = new Date();
                    if (anioExp < hoy.getFullYear() || (anioExp === hoy.getFullYear() && mesExp < hoy.getMonth() + 1)) {
                        alert('La tarjeta se encuentra vencida.');
                        if (inputVence) inputVence.focus();
                        return;
                    }

                    if (cvv.length !== cvvEsperado) {
                        alert('El código de seguridad debe tener exactamente ' + cvvEsperado + ' dígitos.');
                        if (inputCvv) inputCvv.focus();
                        return;
                    }

                    var modalElem = document.getElementById('modalConfirmarPago');
                    if (modalElem && window['bootstrap']) {
                        var modalInstancia = new window['bootstrap'].Modal(modalElem);
                        modalInstancia.show();
                    } else if (confirm('¿Confirma el pago simulado de esta reserva?')) {
                        // Respaldo si el script de Bootstrap no cargó: se envía sin el modal
                        formReal.submit();
                    }
                });
            }

            if (formReal) {
                formReal.addEventListener('submit', function () {
                    if (btnEjecutarPago) {
                        btnEjecutarPago.setAttribute('disabled', 'disabled');
                        btnEjecutarPago.textContent = 'Procesando pago simulado...';
                    }
                    if (btnCancelarModal) {
                        btnCancelarModal.setAttribute('disabled', 'disabled');
                    }
                });
            }
        });
    </script>
}